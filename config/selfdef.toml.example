# selfdef.toml — example configuration.
# Copied by postinst to /etc/selfdef/selfdef.toml if none exists.
#
# Every value below is a default; uncomment and edit to override.

[daemon]
# Hostname tag attached to every event. Defaults to system hostname.
# host_tag = "workstation-01"

# Log level: trace, debug, info, warn, error.
log_level = "info"

# Log format: "text" for journald-friendly, "json" for structured ingest.
log_format = "text"

[deployment]
# Deployment profile (SDD-013/SDD-017). "generic" runs on any Debian/Ubuntu
# host with state under /var/lib/selfdef. "sain01" is the SAIN-01 AI
# workstation (state under /mnt/vault/context on a tank/context ZFS dataset).
# Unknown values fail-loud at parse time.
target = "generic"
# When target = "sain01", refuse to start unless the hardware probe returns
# a full SAIN-01 match (SDD-017 § 5). Default false = warn-only on mismatch.
sain01_strict = false
# Layer B observability: when set, the daemon writes a node_exporter
# textfile-collector .prom with per-dimension hardware-match results
# (SDD-017 § 6). Empty = disabled. Example:
# hardware_metrics_path = "/var/lib/node_exporter/textfile_collector/selfdef-hardware.prom"
hardware_metrics_path = ""
# When set, the daemon writes HardwareCapabilities JSON here at startup
# (SDD-017 § 7), consumed by the sovereign-os Wasm-AOT pipeline. Atomic
# tempfile+rename. Empty = disabled.
hardware_capabilities_path = ""
# Cross-repo cockpit mirror (M060 D-02): when set, the daemon publishes the
# MS007 read-only mirror artifacts (active-profile.json, ...) into this dir
# for sovereign-os cockpit dashboards. Atomic tempfile+rename. Empty =
# disabled. Co-located sovereign-os hosts point at /run/sovereign-os/selfdef-mirror.
selfdef_mirror_dir = ""

[bus]
# `backend` is vestigial — the daemon doesn't branch on it (the
# in-proc broadcast is always the local source of truth; the
# [bus.nats] block below adds a multi-host bridge when enabled).
# Field kept for backward-compatible config parsing; safe to omit.
# See SDD-006 / F-2026-053 for the cleanup plan.
# backend = "inproc"

# Per-topic channel capacity for the in-proc broadcast.
inproc_capacity = 4096

[bus.nats]
# Optional NATS bridge — when enabled and `url` is set, selfdef spawns
# a task that pumps events to/from NATS so detection can span multiple
# hosts. The in-proc bus stays the source of truth for local
# subscribers; NATS is glue between daemons.
#
# Each daemon publishes its locally-originated events to
# `<subject_prefix>.<host_tag>` and subscribes to `<subject_prefix>.>`
# (every host under the prefix, minus its own host_tag — those are
# dropped to avoid the echo loop).
enabled = false
url = ""                                   # e.g. "nats://nats.lan:4222"
subject_prefix = "selfdef.events"

# Optional JetStream durability. With this off, the bridge uses plain
# NATS Core pub/sub — events that pass while a daemon is offline are
# lost. With it on, publishes go to a JetStream stream, inbound reads
# from a per-host durable consumer, and a restarting daemon resumes
# from its last acked message. Requires a NATS server with JetStream
# enabled.
[bus.nats.jetstream]
enabled = false
stream_name = "selfdef-events"
durable_consumer_prefix = "selfdef-bridge"
max_age_secs = 604800                       # 7 days; 0 = unlimited
max_bytes = -1                              # unlimited
max_msgs = -1                               # unlimited

[store]
# Hot store path. Daemon must have rw on this directory.
hot_path = "/var/lib/selfdef/state.sqlite"

# Retention in hot store (days). Enforced by the daemon's retention
# sweep (SDD-081): an initial sweep at startup + every 6h deletes events
# older than this horizon and logs the pruned count. Set to 0 to DISABLE
# retention (keep events forever).
hot_retention_days = 30

# Warm store directory (DuckDB + Parquet).
# warm_path = "/var/lib/selfdef/warm"
# warm_retention_days = 365

[hardware_probe]
# Periodic hardware/thermal probe (SD-R22). When disabled (default) the
# daemon probes hardware ONCE at startup and never re-probes. Enable to
# re-probe on a cadence and (optionally) emit thermal Detection Findings.
enabled = false
# Re-probe cadence in seconds. Default 300 (5 min). Values below 30 are
# rejected at validation time (sub-30s yields no operator value).
interval_seconds = 300
# When true (and enabled=true), a sensor crossing the critical threshold
# emits an OCSF Detection Finding (class_uid=2004, severity=Critical) to
# the bus on the probe tick — i.e. thermal events flow into the notifier
# chain. Default false (probe updates metrics only).
emit_thermal_events = false
# Warn / critical thresholds in °C (sain-01 profile baseline).
thermal_warn_celsius = 85
thermal_critical_celsius = 95
# Override critical threshold for GPU sensors (source prefix
# `nvidia-gpu-`). 0 = use thermal_critical_celsius for GPUs too.
gpu_critical_celsius = 0

[security]
# Rule signing (SDD-006). When require_signed_rules = true, the correlator
# REFUSES to load any rule YAML that lacks a valid detached minisign
# signature (`<rule>.minisig`) verified against signing_public_key_file.
# Default false preserves the existing unsigned-rules workflow; flip it on
# once your rules are signed with the policy key.
require_signed_rules = false
# minisign-format public key used to verify rule signatures. REQUIRED when
# require_signed_rules = true; ignored otherwise.
# signing_public_key_file = "/etc/selfdef/keys/policy.pub"

[perimeter]
# MS047 real-time security perimeter (Tetragon kernel-fence) — overlap
# discipline between selfdef's TracingPolicies and sovereign-os's
# host-scoped allowlist, so the two policy authors don't fence the same
# syscalls twice.
# Run `perimeter check-overlap` before installing a new TracingPolicy.
# Unset resolves per deployment target (on for sain01, off for generic).
# check_overlap_on_apply = true
# sovereign-os's host-scoped allowlist selfdef reads to know what NOT to
# overlap with. Empty = no peer author (overlap check vacuously passes).
sovereign_kernel_fence_path = "/etc/tetragon/tracing-policies/sovereign-kernel-fence.yaml"
# Directory holding all Tetragon TracingPolicy YAMLs (Tetragon's stock
# load path; both policy authors write here).
policies_dir = "/etc/tetragon/tracing-policies"
# When true, overlap detection emits a WARN but does NOT fail apply.
# Default false (block on overlap).
overlap_warn_only = false
# Stance toward THIRD-PARTY Tetragon policies (files not prefixed
# `sovereign-` or `agent-guard-`): "warn" (default — log, don't block) |
# "ignore" (silent) | "block" (treat like agent-guard for overlap; strict).
third_party_policy_stance = "warn"

[collectors]
# Each collector has its own table; all default to disabled.
# `read_from` (where present) accepts "start" (replay from the beginning of
# the source) or "end" (tail new events only). The daemon rejects any other
# value at startup — an unrecognized read_from used to silently default to
# "end", dropping the historical replay you asked for.

[collectors.auditd]
enabled = false
input_path = "/var/log/audit/audit.log"
read_from = "end"

[collectors.journald]
enabled = false
# "journalctl" (spawn journalctl --follow) or "file" (tail a JSONL file).
mode = "journalctl"
journalctl_path = "/usr/bin/journalctl"
units = []  # optional unit filters, e.g. ["sshd.service", "sudo.service"]
# input_path = "/var/log/journal.jsonl"  # used in "file" mode

[collectors.tetragon]
# Ingests Tetragon's *native* JSON event stream (the file Tetragon
# writes via `export-filename` in /etc/tetragon/tetragon.yaml).
# The `tetragon` module manages that config; selfdefctl modules
# apply will refuse to proceed when this block isn't enabled and
# the tetragon module is active (per the manifest's
# [daemon_requires]). NOTE: do NOT add this path to
# [collectors.eventstream] below — that collector expects
# pre-formed selfdef Event JSON and silently drops Tetragon's
# native shape.
enabled = false
input_path = "/var/log/tetragon/events.json"
read_from = "end"

[collectors.suricata]
enabled = false
input_path = "/var/log/suricata/eve.json"
read_from = "end"

[collectors.canary]
# Honeytoken (decoy file) watcher. Lists paths that, if accessed, should
# raise a Critical Detection Finding. Pre-seed each path with realistic-
# looking bait (a fake AWS key, a fake SSH private key, a fake .env) so
# any attempt to exfiltrate them is loud.
enabled = false
paths = []
# Example:
# paths = [
#   "/root/.aws/credentials",
#   "/root/.ssh/id_ed25519_backup",
#   "/etc/secrets/.env",
#   "/home/operator/Documents/passwords.txt",
# ]

[collectors.eventstream]
# Tails JSONL files containing pre-formed selfdef events. Used by
# the client-side ssh wrapper (`selfdef-ssh-wrap`), the
# `integrity-sentinel` module's drift emitter, and any other tool
# invoking `selfdefctl events emit`. Each path is an independent
# producer.
# `selfdefctl modules apply` refuses to proceed when a module's
# [daemon_requires] points at a path missing from this list (the
# integrity-sentinel module declares its
# /var/lib/selfdef/eventstream/integrity-sentinel.jsonl emission
# path via [daemon_requires], so add that line below when you
# activate the module).
enabled = false
read_from = "end"
paths = []
# Examples (uncomment as you activate the relevant producer):
# paths = [
#   "/home/operator/.local/share/selfdef/ssh-wrap.jsonl",
#   "/var/lib/selfdef/eventstream/integrity-sentinel.jsonl",
# ]

# SDD-004 F-2026-026 follow-up: opt-in parse-time integrity
# check. When `true`, the collector refuses to tail any path
# that is world-writable or owned by a UID outside
# {daemon-effective-uid, root} ∪ allowed_owners. Disabled by
# default so the operator-owned shell-wrapper emitter
# (~/.local/share/selfdef/ssh-wrap.jsonl) keeps working without
# extra config. Turn on once the hardening checklist's
# `0750 selfdef:selfdef` posture is in place on the
# /var/lib/selfdef/eventstream/ tree.
integrity_check = false
# Additional UIDs accepted as a writer when integrity_check is
# true. Empty = daemon-effective-uid + root only. Add the
# UID of any deliberate operator-owned emitter here.
allowed_owners = []
# Example with operator-owned ssh-wrap emitter (uid 1000):
# integrity_check = true
# allowed_owners = [1000]

[collectors.ebpf]
# Native in-kernel collection via aya. Requires the BPF object compiled
# and installed (see docs/ebpf.md) and the systemd ebpf.conf drop-in.
# The daemon degrades gracefully if program_path doesn't exist or if a
# given probe fails to attach (e.g. LSM on a kernel without BPF LSM).
# Leave off if you have Tetragon running — there's overlap.
enabled = false
program_path = "/usr/lib/selfdef/selfdef.bpf.o"
enable_execve = true            # tracepoint:syscalls:sys_enter_execve + argv capture
enable_lsm_open = false         # lsm/file_open — needs CONFIG_BPF_LSM=y + `bpf` in CONFIG_LSM
enable_kprobe_unlink = false    # kprobe:do_unlinkat — noisy on busy hosts

[correlator]
rules_dir = "/etc/selfdef/rules"
# Rule hot-reload on SIGHUP (without restarting the daemon) is ALWAYS ON —
# `selfdefctl reload` / `kill -HUP` reloads rules_dir and keeps the prior
# ruleset if the new one fails to verify. It is not a toggle (a stale
# `hot_reload = true/false` key here was a phantom: not a real field, so
# it was silently ignored — removed to avoid implying it can be disabled).
# `window_secs` and `threshold` are vestigial — Sigma rules carry
# their own time window and threshold per-rule. The daemon does not
# read these fields. Closes F-2026-015. Safe to omit.
# window_secs = 60
# threshold = 3

[notifier]
# Order matters: first channel that succeeds wins.
channels = ["ntfy"]

[notifier.ntfy]
# url = "https://ntfy.example.org"
# topic = "selfdef-alerts"
# token_file = "/etc/selfdef/secrets/ntfy.token"
url = ""
topic = ""

[notifier.signal]
binary = "/usr/bin/signal-cli"
account = ""
recipient = ""

# SDD-008 D-7 Q-E — SMTP (email) outbound channel via lettre.
# Empty relay_host keeps the channel disabled. Default TLS profile is
# starttls (port 587 with PLAIN auth over upgraded TLS — the most
# common operator-controlled relay posture). Use implicit_tls for
# port-465 deployments; plain refuses any auth-bearing send at
# construction time.
[notifier.smtp]
# relay_host = "smtp.example.org"
# relay_port = 587
# tls = "starttls"                              # starttls | implicit_tls | plain
# username = "alerts@example.org"
# password_file = "/etc/selfdef/secrets/smtp.password"  # mode 0600
# from = "selfdef-alerts@example.org"
# to = ["oncall@example.org"]
# timeout_secs = 10
relay_host = ""
relay_port = 587
tls = "starttls"
from = ""
to = []
timeout_secs = 10

# SDD-008 Q-D — Twilio SMS outbound channel.
# Empty account_sid keeps the channel disabled. v1 ships send-only;
# inbound reply webhooks for SMS ack would require a public HTTPS
# endpoint and are deferred. Numbers must be E.164 (+15551234567).
[notifier.twilio]
# account_sid = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# auth_token_file = "/etc/selfdef/secrets/twilio.token"  # mode 0600
# from = "+15551234567"
# to = ["+15559876543"]
# timeout_secs = 10
account_sid = ""
from = ""
to = []
timeout_secs = 10

# SDD-008 Q-C — Slack incoming-webhook outbound channel.
# Missing webhook_url_file keeps the channel disabled. The webhook URL
# IS the auth secret — anyone with it can post to the channel — so
# store it in a separate file at mode 0600.
[notifier.slack]
# webhook_url_file = "/etc/selfdef/secrets/slack.webhook"  # mode 0600
# username = "selfdef"
# icon_emoji = ":shield:"
username = "selfdef"
icon_emoji = ":shield:"

# SDD-008 — Discord webhook outbound channel.
# Same shape as Slack: the webhook URL is the auth secret; store it
# in a separate file at mode 0600.
[notifier.discord]
# webhook_url_file = "/etc/selfdef/secrets/discord.webhook"  # mode 0600
# username = "selfdef"
username = "selfdef"

# SDD-008 Q-G — PagerDuty Events API v2 channel.
# Missing routing_key_file keeps the channel disabled. The 32-char hex
# routing key (per-service integration key from PagerDuty's UI) IS the
# auth; store at mode 0600. Leave `endpoint` empty for the global US
# endpoint; set it explicitly for EU-only or staging.
[notifier.pagerduty]
# routing_key_file = "/etc/selfdef/secrets/pagerduty.key"  # mode 0600
# endpoint = ""
# source = "selfdef"
endpoint = ""
source = "selfdef"

# SDD-008 Q-G — Grafana Loki push-API channel.
# Empty endpoint keeps the channel disabled. Must be https:// (refuses
# to ship bearer tokens over plaintext). Three auth modes:
#   • self-hosted single-tenant — leave tenant_id empty, no auth_token_file.
#   • self-hosted multi-tenant  — set tenant_id (sent as X-Scope-OrgID).
#   • Grafana Cloud             — set both tenant_id (stack id) and
#                                 auth_token_file (API key — sent as Bearer).
[notifier.loki]
# endpoint = "https://logs-prod.grafana.net/loki/api/v1/push"
# tenant_id = ""                                         # required for cloud/multi-tenant
# auth_token_file = "/etc/selfdef/secrets/loki.token"    # mode 0600
# source = "selfdef"
endpoint = ""
tenant_id = ""
source = "selfdef"

# SDD-008 Q-G — OpenSearch / Elasticsearch document-index channel.
# Empty endpoint keeps the channel disabled. Must be https://. Each
# event becomes one document indexed at <endpoint>/<index>/_doc.
# auth_kind is one of "none" | "basic" | "apikey" — unknown values are
# rejected at startup so operators see the misconfig.
[notifier.opensearch]
# endpoint = "https://opensearch.internal:9200"
# index = "selfdef-events"
# auth_kind = "none"                                     # none | basic | apikey
# username = ""                                          # required for basic
# auth_token_file = "/etc/selfdef/secrets/opensearch.auth"  # mode 0600 (password or apikey)
# source = "selfdef"
endpoint = ""
index = ""
auth_kind = "none"
username = ""
source = "selfdef"

# SDD-008 Q-G — TheHive incident-management alert channel.
# Empty endpoint keeps the channel disabled. Must be https://. The
# Bearer API key in api_key_file IS the auth — store at mode 0600.
# Each event POSTs to <endpoint>/api/v1/alert; TLP defaults to Amber
# (SOC-internal posture).
[notifier.thehive]
# endpoint = "https://hive.internal:9000"
# api_key_file = "/etc/selfdef/secrets/thehive.key"      # mode 0600
# source = "selfdef"
# alert_type = "selfdef"
endpoint = ""
source = "selfdef"
alert_type = "selfdef"

# SDD-008 D-8 — wall(1) session-attention channel.
# Broadcasts to every logged-in TTY when a high-severity event fires.
# Empty binary keeps the channel disabled. severity_floor defaults to
# "high" — wall is system-wide, bothering every TTY on routine events
# is wrong.
#
# Note: wall(1) does NOT filter per-user. For per-user opt-in
# (allowlist of operator accounts), configure [notifier.write] instead
# — that's the sibling per-user transport (D-024 realization of D-004).
[notifier.wall]
# binary = "/usr/bin/wall"
# severity_floor = "high"                                # informational | low | medium | high | critical | fatal
binary = ""
severity_floor = "high"

# SDD-008 D-024 — write(1) per-user session-attention channel.
# Sibling of wall(1) for per-user TTY delivery: each name in `users`
# receives a per-user `write(1) <name>` invocation. Empty binary OR
# empty users keeps the channel disabled. Usernames must match
# [a-zA-Z0-9._-]+ — shell metacharacters are rejected at config-load.
[notifier.write]
# binary = "/usr/bin/write"
# severity_floor = "high"
# users = ["alice", "bob"]
binary = ""
severity_floor = "high"
users = []

# SDD-008 D-3 — per-channel subscription filters (optional).
# Missing entry = accept every event. severity_floor + event_kinds
# both compose (event must pass BOTH to fire on this channel).
# Example: route only high+ findings to PagerDuty, everything to Loki:
#   [notifier.subscriptions.pagerduty]
#   severity_floor = "high"
#   event_kinds = ["security", "detection"]
#
#   [notifier.subscriptions.loki]
#   severity_floor = "informational"

# SDD-008 D-5a/b/c — persistent escalation engine.
# When set, the daemon opens this SQLite file at startup, persists
# outbound events in it, and runs the wake-task escalation loop.
# When unset (default), the daemon falls back to the M4 fire-and-
# forget chain (no persistence, no escalation). Used by both the
# daemon and `selfdefctl notify {ack,forget,list}`.
# escalations_path = "/var/lib/selfdef/escalations.sqlite"

# SDD-008 D-6a — dispatcher operating mode.
# enforce (default) = production; fires channels for real.
# audit             = persists rows but does NOT call channel.send —
#                     dry-run for verifying orchestrator wiring before
#                     going live. Only consulted when escalations_path
#                     is set; the M4 chain path always behaves as enforce.
# mode = "enforce"

# SDD-008 D-6b — named escalation profile.
# auto       (default) = 2 attempts, 5-min ack window.
# aggressive           = 3 attempts at 60s / 180s / 600s. Wake-the-on-call.
# patient              = 4 attempts at 10/30/60/120 min. Low-noise channels.
# Operators can also name a custom profile defined under
# [notifier.profiles.<name>] (see below).
# profile = "auto"

# SDD-008 D-7 — panic floor (audit-mode bypass).
# Severity threshold at or above which audit mode is bypassed
# (channels fire for real even when mode = "audit"). The escape hatch
# for "operator misconfiguration cannot leave a blocker un-notified".
# One of: informational | low | medium | high | critical | fatal.
# Unset = no floor (audit mode suppresses every severity).
# panic_floor = "critical"

# SDD-008 D-6c — operator-defined custom escalation profiles.
# Active profile is picked by [notifier].profile. When that name
# matches a key here, the daemon constructs a custom profile from
# this configured rung sequence. Empty channels at a rung = "fire all
# configured channels" (WUPHF semantics).
# [notifier.profiles.weekend]
# rungs = [
#     { channels = ["ntfy"],   ack_window_secs = 1800 },
#     { channels = ["signal"], ack_window_secs = 3600 },
#     { channels = [],         ack_window_secs = 600  },  # WUPHF
# ]

# SDD-008 D-4 HTTP ack — optional click-link ack endpoint base URL.
# When set, the dispatcher mints a per-event UUIDv7 token, appends it
# to this base (<base>/<token>), and embeds the result in each
# outbound payload's ack_link. Operators click the link → daemon's
# GET /notify/ack/:token records the ack. Unset (default) = ack is
# CLI-only via `selfdefctl notify ack <event-id>`.
# Note: NO trailing slash; the dispatcher appends /<token> exactly.
# ack_link_base = "https://selfdef.example.org/notify/ack"

[responder]
# Dry-run prints what would be done without executing. Flip to false once
# you trust your action allowlist and have verified the scripts behave.
dry_run = true

# Actions allowed in this deployment. The seven built-ins are:
#   notify                 — send to the configured notifier chain
#   snapshot_proc          — dump /proc/<pid>/{cmdline,exe,maps,environ,…} to disk
#   kill_pid               — SIGTERM the actor pid
#   lockdown_egress        — invoke the lockdown script (egress isolation)
#   revoke_session         — invoke the revoke-session script (loginctl wrapper)
#   forensics_bundle       — write an evidence bundle (event, /proc, dmesg,
#                            journalctl, ss, /etc/passwd, /proc/net/*, ...)
#                            to forensics_dir/<event-uuid>/
#   velociraptor_escalate  — invoke a configured Velociraptor CLI with
#                            templated args ({event_id}, {host_tag})
allowed_actions = ["notify"]
# Powerful actions, opt-in only after you've tested:
# allowed_actions = ["notify", "snapshot_proc", "lockdown_egress", "kill_pid",
#                    "revoke_session", "forensics_bundle", "velociraptor_escalate"]

# Autonomous-response severity floor. Findings graded below this are NOT
# auto-dispatched on the bus path — a guard so an allow-listed aggressive
# action (e.g. kill_pid) never fires on a low-confidence finding. Accepts
# `none` (default — every finding processed, the historical behavior) or a
# grade: info, low, medium, high, critical, fatal. Recommended once you enable
# powerful actions: floor them to `high` so only high-confidence findings act.
# Note: operator-commanded paths (`selfdefctl panic`, the authenticated
# /actions/{name}/run API) bypass this floor by design — it gates autonomous
# response only.
min_severity = "none"
# Example: only High/Critical/Fatal findings trigger autonomous actions:
# min_severity = "high"

# Where snapshot_proc writes per-event directories.
snapshot_dir = "/var/lib/selfdef/snapshots"

# Operator-owned scripts. Install with mode 0750 root:root. Example
# implementations live in packaging/scripts/ in the source tree.
lockdown_script = "/usr/local/sbin/selfdef-lockdown.sh"
revoke_session_script = "/usr/local/sbin/selfdef-revoke-session.sh"

# Where forensics_bundle writes per-event evidence directories. Each bundle
# is `forensics_dir/<event-uuid>/` and contains event.json, system metadata,
# /proc state for the actor pid (if any), dmesg, journalctl, and a manifest.
# Use `selfdefctl forensics list` to inspect, `selfdefctl forensics collect
# <event-id>` to (re)create a bundle for any event already in the hot store.
forensics_dir = "/var/lib/selfdef/forensics"

# Velociraptor escalation. The action invokes
#   velociraptor_binary velociraptor_args...
# with `{event_id}` and `{host_tag}` substituted in any arg. Leave args
# empty to disable the action even if `velociraptor_escalate` is in
# allowed_actions — the action runs successfully with no operational
# effect. Operator owns the actual workflow (client-side artifact
# collection, server-side hunt creation, …).
velociraptor_binary = "/usr/local/bin/velociraptor"
velociraptor_args = []
# Example (client-side artifact collection on every Critical finding):
# velociraptor_args = [
#   "--config", "/etc/velociraptor/client.config.yaml",
#   "client", "collect",
#   "--artifact=Generic.Forensic.SQLiteHunter",
#   "--label={host_tag}",
#   "--tag={event_id}",
# ]
# Example (server-side hunt creation, useful from a tooling host):
# velociraptor_args = [
#   "--config", "/etc/velociraptor/server.config.yaml",
#   "hunts", "add",
#   "--artifact=Linux.Detection.SELinux.Audit",
#   "--description=selfdef escalation host={host_tag} event={event_id}",
# ]

[api]
# Read-only HTTP API for the dashboard and selfdefctl's future IPC
# channel. Two transports, either or both:
#
#   - UNIX socket: trusted via filesystem permissions. No bearer token.
#     The default mode (0660) lets root + group `adm` read/write — add
#     your operator user to `adm` (or change `unix_socket_mode`) for
#     unprivileged access via selfdefctl.
#
#   - TCP: requires `Authorization: Bearer <token>` matching the
#     contents of `token_file`. Bind to 127.0.0.1 unless you're putting
#     a real reverse proxy in front.
#
# When `enabled = false`, no API task runs and neither socket is created.
enabled = false
unix_socket = "/run/selfdef.sock"
unix_socket_mode = "0660"
tcp_addr = ""                                # e.g. "127.0.0.1:8443"

# Bearer tokens for the TCP transport. UNIX socket clients bypass both
# (filesystem permissions on the socket are the auth boundary).
#
# - token_file: required when tcp_addr is set. Grants the read-only API
#   (status / events / findings / events/stream / actions discovery).
# - control_token_file: optional. Grants the read-only API *plus* the
#   control verbs (rules/reload, panic, actions/{name}/run). Leave
#   empty to refuse every control verb over TCP — the daemon's "writes"
#   surface only opens up when an operator explicitly populates this.
token_file = "/etc/selfdef/api.token"
control_token_file = ""                      # e.g. "/etc/selfdef/api-control.token"

# MS022 SSE subscriber-quota caps. The daemon enforces these on every
# /v1/events/stream connect via SubscriberGuard::try_acquire — over-cap
# requests get HTTP 429. The cap state is exposed at /metrics as 6
# Prometheus gauges (selfdef_sse_subscribers_*) that sovereign-os
# alerts + Grafana panel consume.
#
# Defaults are conservative — most deployments don't need to tune
# these. See docs/operator/ms022-sse-subscriber-quota.md for the
# raise-vs-leak diagnosis decision tree.
#
# Unset / 0 / commented → compiled defaults: 64 global, 8 per-token.
# max_sse_subscribers           = 128
# max_sse_subscribers_per_token = 16

# Optional TLS for the TCP transport.
#   - cert_path + key_path empty → plain HTTP over TCP (bearer-token only).
#   - cert_path + key_path set   → TLS.
#   - tls.client_ca also set     → mTLS (client cert required + verified).
[api.tls]
cert_path = ""                               # e.g. "/etc/selfdef/api-cert.pem"
key_path = ""                                # e.g. "/etc/selfdef/api-key.pem"
client_ca = ""                               # e.g. "/etc/selfdef/clients-ca.pem"

# ---------------------------------------------------------------- deployment
# Deployment-target + cross-repo export knobs. All optional; defaults yield
# the legacy single-host generic deployment with no exports.
#
# [deployment]
# target = "generic"          # or "sain01" — selects state-dir layout
#                             # (SDD-013); generic = /var/lib/selfdef,
#                             # sain01 = /mnt/vault/context (ZFS).
# sain01_strict = false       # SDD-017 §5: refuse to start on sain01
#                             # target when hardware probe doesn't match.
# hardware_metrics_path = ""  # SDD-017 §6: Layer B textfile-collector
#                             # path for sain01_match (.prom). Operator
#                             # opts in by pointing at their node_exporter
#                             # textfile dir.
# hardware_capabilities_path = ""
#                             # SDD-017 §7 / SD-R10: HardwareCapabilities
#                             # JSON export consumed by sovereign-os
#                             # Wasm-AOT + hardware-aware policies.
#
# # ---- M060 cross-repo mirror export (D-02/13/14/15/17/18) ----
# # When set, the daemon republishes each domain's daemon-resident
# # registry READ-ONLY to this directory for the sovereign-os cockpit
# # dashboards (D-02 active-profile, D-13 grants, D-14 capability-tokens,
# # D-15 sandboxes, D-17 quarantine, D-18 trust-scores). Atomic
# # tempfile+rename, 30s cadence, honest-offline when a domain's resident
# # store is absent (no fabricated empty-online state). Co-located
# # operators on a host that runs sovereign-os enable this by pointing
# # at /run/sovereign-os/selfdef-mirror; sovereign-os mounts the dir as
# # the consumer side and renders read-only per MS043 R10212.
# selfdef_mirror_dir = "/run/sovereign-os/selfdef-mirror"
#
# # Per-domain resident-store overrides — only set if you've relocated
# # the daemon's persistent state. Defaults are the registry crates'
# # DEFAULT_STATE_PATH (/var/lib/selfdef/{grants,capability-tokens,
# # sandboxes,quarantine,trust-scores}.json). Whatever path the daemon
# # reads here must agree with the path the API + selfdefctl write to
# # — both honor the same SELFDEF_<DOMAIN>_PATH env override.
# # SELFDEF_GRANTS_PATH=...
# # SELFDEF_CAPABILITY_TOKENS_PATH=...
# # SELFDEF_SANDBOXES_PATH=...
# # SELFDEF_QUARANTINE_PATH=...
# # SELFDEF_TRUST_SCORES_PATH=...
