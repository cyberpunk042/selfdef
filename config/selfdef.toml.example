# selfdef.toml — example configuration.
# Copied by postinst to /etc/selfdef/selfdef.toml if none exists.
#
# Every value below is a default; uncomment and edit to override.

[daemon]
# Hostname tag attached to every event. Defaults to system hostname.
# host_tag = "workstation-01"

# Log level: trace, debug, info, warn, error.
log_level = "info"

# Log format: "text" for journald-friendly, "json" for structured ingest.
log_format = "text"

[bus]
# "inproc" (default) or "nats". inproc is fine for single-host deployments.
backend = "inproc"

# Per-topic channel capacity for the in-proc broadcast.
inproc_capacity = 4096

# [bus.nats]
# url = "nats://127.0.0.1:4222"
# stream = "selfdef-events"

[store]
# Hot store path. Daemon must have rw on this directory.
hot_path = "/var/lib/selfdef/state.sqlite"

# Retention in hot store (days). After this, events age out to warm.
hot_retention_days = 30

# Warm store directory (DuckDB + Parquet).
# warm_path = "/var/lib/selfdef/warm"
# warm_retention_days = 365

[collectors]
# Each collector has its own table; all default to disabled.

[collectors.auditd]
enabled = false
input_path = "/var/log/audit/audit.log"
read_from = "end"

[collectors.journald]
enabled = false
# "journalctl" (spawn journalctl --follow) or "file" (tail a JSONL file).
mode = "journalctl"
journalctl_path = "/usr/bin/journalctl"
units = []  # optional unit filters, e.g. ["sshd.service", "sudo.service"]
# input_path = "/var/log/journal.jsonl"  # used in "file" mode

[collectors.tetragon]
enabled = false
input_path = "/var/log/tetragon/events.json"
read_from = "end"

[collectors.suricata]
enabled = false
input_path = "/var/log/suricata/eve.json"
read_from = "end"

[collectors.canary]
# Honeytoken (decoy file) watcher. Lists paths that, if accessed, should
# raise a Critical Detection Finding. Pre-seed each path with realistic-
# looking bait (a fake AWS key, a fake SSH private key, a fake .env) so
# any attempt to exfiltrate them is loud.
enabled = false
paths = []
# Example:
# paths = [
#   "/root/.aws/credentials",
#   "/root/.ssh/id_ed25519_backup",
#   "/etc/secrets/.env",
#   "/home/operator/Documents/passwords.txt",
# ]

[collectors.eventstream]
# Tails JSONL files containing pre-formed selfdef events. Used by the
# client-side ssh wrapper (`selfdef-ssh-wrap`) and any other tool that
# wants to inject events. Each path is an independent producer.
enabled = false
read_from = "end"
paths = []
# Example:
# paths = ["/home/operator/.local/share/selfdef/ssh-wrap.jsonl"]

[collectors.ebpf]
# Native in-kernel collection via aya. Requires the BPF object compiled
# and installed (see docs/ebpf.md) and the systemd ebpf.conf drop-in.
# The daemon degrades gracefully if program_path doesn't exist or if a
# given probe fails to attach (e.g. LSM on a kernel without BPF LSM).
# Leave off if you have Tetragon running — there's overlap.
enabled = false
program_path = "/usr/lib/selfdef/selfdef.bpf.o"
enable_execve = true            # tracepoint:syscalls:sys_enter_execve + argv capture
enable_lsm_open = false         # lsm/file_open — needs CONFIG_BPF_LSM=y + `bpf` in CONFIG_LSM
enable_kprobe_unlink = false    # kprobe:do_unlinkat — noisy on busy hosts

[correlator]
rules_dir = "/etc/selfdef/rules"
# Reload rules on SIGHUP without restarting the daemon.
hot_reload = true
# Built-in SSH brute-force rule:
window_secs = 60
threshold = 3

[notifier]
# Order matters: first channel that succeeds wins.
channels = ["ntfy"]

[notifier.ntfy]
# url = "https://ntfy.example.org"
# topic = "selfdef-alerts"
# token_file = "/etc/selfdef/secrets/ntfy.token"
url = ""
topic = ""

[notifier.signal]
binary = "/usr/bin/signal-cli"
account = ""
recipient = ""

[responder]
# Dry-run prints what would be done without executing. Flip to false once
# you trust your action allowlist and have verified the scripts behave.
dry_run = true

# Actions allowed in this deployment. The seven built-ins are:
#   notify                 — send to the configured notifier chain
#   snapshot_proc          — dump /proc/<pid>/{cmdline,exe,maps,environ,…} to disk
#   kill_pid               — SIGTERM the actor pid
#   lockdown_egress        — invoke the lockdown script (egress isolation)
#   revoke_session         — invoke the revoke-session script (loginctl wrapper)
#   forensics_bundle       — write an evidence bundle (event, /proc, dmesg,
#                            journalctl, ss, /etc/passwd, /proc/net/*, ...)
#                            to forensics_dir/<event-uuid>/
#   velociraptor_escalate  — invoke a configured Velociraptor CLI with
#                            templated args ({event_id}, {host_tag})
allowed_actions = ["notify"]
# Powerful actions, opt-in only after you've tested:
# allowed_actions = ["notify", "snapshot_proc", "lockdown_egress", "kill_pid",
#                    "revoke_session", "forensics_bundle", "velociraptor_escalate"]

# Where snapshot_proc writes per-event directories.
snapshot_dir = "/var/lib/selfdef/snapshots"

[api]
# Read-only HTTP API for the dashboard and selfdefctl's future IPC
# channel. Two transports, either or both:
#
#   - UNIX socket: trusted via filesystem permissions. No bearer token.
#     The default mode (0660) lets root + group `adm` read/write — add
#     your operator user to `adm` (or change `unix_socket_mode`) for
#     unprivileged access via selfdefctl.
#
#   - TCP: requires `Authorization: Bearer <token>` matching the
#     contents of `token_file`. Bind to 127.0.0.1 unless you're putting
#     a real reverse proxy in front.
#
# When `enabled = false`, no API task runs and neither socket is created.
enabled = false
unix_socket = "/run/selfdef.sock"
unix_socket_mode = "0660"
tcp_addr = ""                                # e.g. "127.0.0.1:8443"

# Bearer tokens for the TCP transport. UNIX socket clients bypass both
# (filesystem permissions on the socket are the auth boundary).
#
# - token_file: required when tcp_addr is set. Grants the read-only API
#   (status / events / findings / events/stream / actions discovery).
# - control_token_file: optional. Grants the read-only API *plus* the
#   control verbs (rules/reload, panic, actions/{name}/run). Leave
#   empty to refuse every control verb over TCP — the daemon's "writes"
#   surface only opens up when an operator explicitly populates this.
token_file = "/etc/selfdef/api.token"
control_token_file = ""                      # e.g. "/etc/selfdef/api-control.token"

# Optional TLS for the TCP transport.
#   - cert_path + key_path empty → plain HTTP over TCP (bearer-token only).
#   - cert_path + key_path set   → TLS.
#   - tls.client_ca also set     → mTLS (client cert required + verified).
[api.tls]
cert_path = ""                               # e.g. "/etc/selfdef/api-cert.pem"
key_path = ""                                # e.g. "/etc/selfdef/api-key.pem"
client_ca = ""                               # e.g. "/etc/selfdef/clients-ca.pem"

# Operator-owned scripts. Install with mode 0750 root:root. Example
# implementations live in packaging/scripts/ in the source tree.
lockdown_script = "/usr/local/sbin/selfdef-lockdown.sh"
revoke_session_script = "/usr/local/sbin/selfdef-revoke-session.sh"

# Where forensics_bundle writes per-event evidence directories. Each bundle
# is `forensics_dir/<event-uuid>/` and contains event.json, system metadata,
# /proc state for the actor pid (if any), dmesg, journalctl, and a manifest.
# Use `selfdefctl forensics list` to inspect, `selfdefctl forensics collect
# <event-id>` to (re)create a bundle for any event already in the hot store.
forensics_dir = "/var/lib/selfdef/forensics"

# Velociraptor escalation. The action invokes
#   velociraptor_binary velociraptor_args...
# with `{event_id}` and `{host_tag}` substituted in any arg. Leave args
# empty to disable the action even if `velociraptor_escalate` is in
# allowed_actions — the action runs successfully with no operational
# effect. Operator owns the actual workflow (client-side artifact
# collection, server-side hunt creation, …).
velociraptor_binary = "/usr/local/bin/velociraptor"
velociraptor_args = []
# Example (client-side artifact collection on every Critical finding):
# velociraptor_args = [
#   "--config", "/etc/velociraptor/client.config.yaml",
#   "client", "collect",
#   "--artifact=Generic.Forensic.SQLiteHunter",
#   "--label={host_tag}",
#   "--tag={event_id}",
# ]
# Example (server-side hunt creation, useful from a tooling host):
# velociraptor_args = [
#   "--config", "/etc/velociraptor/server.config.yaml",
#   "hunts", "add",
#   "--artifact=Linux.Detection.SELinux.Audit",
#   "--description=selfdef escalation host={host_tag} event={event_id}",
# ]
