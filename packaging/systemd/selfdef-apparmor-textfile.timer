[Unit]
Description=Selfdef — periodic AppArmor profile-enforcement observer (every 60s)
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-apparmor-textfile.sh
# Pairs with selfdef-apparmor-textfile.service. 60s cadence matches
# the 5 sibling observers — same observer-freshness contract via
# last_run_unix. Offset boot delay by 180s so this is the 6th and
# latest observer timer to fire after boot.
# Sibling cadences: cli-mirror 60s, m060 70s, four-watchdog 90s,
# modules 120s, daemon-process 150s, apparmor 180s — 6 distinct
# boot offsets.

[Timer]
OnBootSec=180s
OnUnitActiveSec=60s
AccuracySec=5s
RandomizedDelaySec=10s
Unit=selfdef-apparmor-textfile.service

[Install]
WantedBy=timers.target
