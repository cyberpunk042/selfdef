[Unit]
Description=Selfdef — emit SDD-076 kernel-keyring-eviction state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-kernel-keyring-evictions-textfile.sh
# 30th sibling. Extends the IPS-undectet observability set → duodectet
# at the kernel-keyring axis.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_KERNEL_KEYRING_EVICTIONS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-kernel-keyring-evictions.prom
Environment=SELFDEF_KERNEL_KEYRING_EVICTIONS_STATE_DIR=/var/lib/selfdef/kernel-keyring-evictions
ExecStart=/usr/share/selfdef/selfdef-kernel-keyring-evictions-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
