[Unit]
Description=Selfdef — emit SDD-075 per-process capability-drop state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-capability-drops-textfile.sh
# 29th sibling. Extends the IPS-dectet observability set → undectet
# at the per-process privilege-set axis.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_CAPABILITY_DROPS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-capability-drops.prom
Environment=SELFDEF_CAPABILITY_DROPS_STATE_DIR=/var/lib/selfdef/capability-drops
ExecStart=/usr/share/selfdef/selfdef-capability-drops-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
