[Unit]
Description=Selfdef — periodic SDD-071 mount-binding unbind observer (every 60s, 25th sibling)
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-mount-bindings-textfile.sh
# OnBootSec=750s — distinct from the prior 24 siblings (60s..720s).

[Timer]
OnBootSec=750s
OnUnitActiveSec=60s
AccuracySec=5s
RandomizedDelaySec=10s
Unit=selfdef-mount-bindings-textfile.service

[Install]
WantedBy=timers.target
