[Unit]
Description=selfdef daemon
Documentation=https://example.org/you/selfdef
After=network-online.target auditd.service systemd-journald.service
Wants=network-online.target
RequiresMountsFor=/var/lib/selfdef /var/log/selfdef

[Service]
Type=notify
NotifyAccess=main
# Pre-flight the config before the real start. A parse error or a semantic
# fail-fast rejection (see `selfdefd --validate`) fails the unit cleanly at
# the pre-start stage — the INVALID reason lands in the journal — instead of
# ExecStart crash-looping under Restart=on-failure. Runs in the same
# sandbox; only reads /etc/selfdef (ReadOnlyPaths), starts nothing.
ExecStartPre=/usr/bin/selfdefd --config /etc/selfdef/selfdef.toml --validate
ExecStart=/usr/bin/selfdefd --config /etc/selfdef/selfdef.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# Liveness watchdog: the daemon emits `sd_notify WATCHDOG=1` every 30s
# (run_heartbeat). A 60s window = two beats, so a HEALTHY daemon never trips,
# but a HUNG one (deadlocked / runtime wedged — alive but not beating, which
# Restart=on-failure can't catch because the process hasn't exited) is killed +
# restarted by systemd at the deadline. Without the directive below the
# WATCHDOG=1 sends are inert (systemd ignores them) and a hang is invisible.
WatchdogSec=60

# --- identity ---
User=selfdef
Group=selfdef
# Owner-only default for everything the daemon creates (hot store
# `/var/lib/selfdef/state.sqlite` + its `-wal`/`-shm` siblings, escalations db,
# any state file written without an explicit mode). Without this the file mode
# is the inherited umask — typically 0022 → 0644 = a WORLD-READABLE forensic
# store. The /metrics + /v1 unix socket is unaffected: its mode is set
# explicitly via `set_unix_socket_mode` (set_permissions) after bind, which
# overrides the umask, so `[api].unix_socket_mode` (default 0660) still holds.
UMask=0077

# --- capabilities ---
# Minimal default set. Individual collectors may need elevations granted
# via drop-in files in /etc/systemd/system/selfdefd.service.d/
CapabilityBoundingSet=CAP_AUDIT_READ CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
AmbientCapabilities=CAP_AUDIT_READ
# Note: CAP_BPF + CAP_PERFMON only need ambient when collectors.ebpf is enabled.
# Add them via a drop-in (/etc/systemd/system/selfdefd.service.d/ebpf.conf)
# rather than here so the default install retains least-privilege ambient set:
#   [Service]
#   AmbientCapabilities=CAP_AUDIT_READ CAP_BPF CAP_PERFMON
# CAP_SYS_RESOURCE is needed on kernels that account locked memory for BPF maps.
NoNewPrivileges=true

# --- filesystem ---
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/selfdef /var/log/selfdef
ReadOnlyPaths=/etc/selfdef
PrivateTmp=true
PrivateDevices=true

# --- kernel & namespaces ---
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true

# --- syscalls ---
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# --- network ---
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
# Add IPAddressAllow= entries for ntfy/signal-cli endpoints in a drop-in.

# --- logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=selfdefd

[Install]
WantedBy=multi-user.target
