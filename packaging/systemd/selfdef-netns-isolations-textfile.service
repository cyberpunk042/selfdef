[Unit]
Description=Selfdef — emit SDD-070 netns-isolation state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-netns-isolations-textfile.sh
# 24th sibling. Extends the IPS-pentet observability set → hexet.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_NETNS_ISOLATIONS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-netns-isolations.prom
Environment=SELFDEF_NETNS_ISOLATIONS_STATE_DIR=/var/lib/selfdef/netns-isolations
ExecStart=/usr/share/selfdef/selfdef-netns-isolations-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
