[Unit]
Description=Selfdef — periodic module-catalog textfile observer (every 60s)
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-modules-textfile.sh
# Pairs with selfdef-modules-textfile.service. 60s cadence matches
# the sibling cli-mirror-doctor + m060-doctor + four-watchdog-doctor
# timers — same observer-freshness contract surfaced through
# last_run_unix. Offset boot delay by 120s so the timer doesn't
# pile up against the other doctor timers at the same moment
# (sibling cadences: cli-mirror 60s, m060 70s, four-watchdog 90s,
# this 120s).

[Timer]
OnBootSec=120s
OnUnitActiveSec=60s
# Wedged-timer detection lives in selfdef_modules_last_run_unix
# going stale; the Prometheus rule paging on observer-freshness
# covers the case where this timer stops firing.
AccuracySec=5s
# Randomize fleet-wide fire moment to avoid synchronized writes.
RandomizedDelaySec=10s
Unit=selfdef-modules-textfile.service

[Install]
WantedBy=timers.target
