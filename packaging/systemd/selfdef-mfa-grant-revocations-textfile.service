[Unit]
Description=Selfdef — emit SDD-069 MFA-grant revocation state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-mfa-grant-revocations-textfile.sh
# 23rd sibling. Completes the IPS-pentet observability set.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_MFA_GRANT_REVOCATIONS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-mfa-grant-revocations.prom
Environment=SELFDEF_MFA_GRANT_REVOCATIONS_STATE_DIR=/var/lib/selfdef/mfa-grant-revocations
ExecStart=/usr/share/selfdef/selfdef-mfa-grant-revocations-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
