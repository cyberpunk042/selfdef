[Unit]
Description=Selfdef — emit SSH server hardening baseline textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-sshd-config-textfile.sh
# Runs every 60s. Surfaces SSH hardening baseline state — content
# hash + 7 safety toggles. Pairs with auth-events (11th sibling)
# at the attack-surface axis.
#
# 16th sibling observer. Same R171 hardening as siblings.

After=local-fs.target

[Service]
Type=oneshot

User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_SSHD_CONFIG_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-sshd-config.prom
ExecStart=/usr/share/selfdef/selfdef-sshd-config-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef /etc/ssh
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
