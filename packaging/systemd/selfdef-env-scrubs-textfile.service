[Unit]
Description=Selfdef — emit SDD-074 process-env scrub state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-env-scrubs-textfile.sh
# 28th sibling. Extends the IPS-nonet observability set → dectet
# at the in-memory secret-residency axis.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_ENV_SCRUBS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-env-scrubs.prom
Environment=SELFDEF_ENV_SCRUBS_STATE_DIR=/var/lib/selfdef/env-scrubs
ExecStart=/usr/share/selfdef/selfdef-env-scrubs-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
