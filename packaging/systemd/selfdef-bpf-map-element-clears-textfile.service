[Unit]
Description=Selfdef — emit SDD-078 BPF map element clear state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-bpf-map-element-clears-textfile.sh
# 32nd sibling. Extends the IPS-tridectet observability set → quattuordectet
# at the eBPF map state axis.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_BPF_MAP_ELEMENT_CLEARS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-bpf-map-element-clears.prom
Environment=SELFDEF_BPF_MAP_ELEMENT_CLEARS_STATE_DIR=/var/lib/selfdef/bpf-map-element-clears
ExecStart=/usr/share/selfdef/selfdef-bpf-map-element-clears-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
