[Unit]
Description=Selfdef — emit SDD-072 process-tree freeze state textfile
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-process-tree-freezes-textfile.sh
# 26th sibling. Extends the IPS-septet observability set → octet
# at the process-graph containment axis.
# Standard 12-clause R171 hardening.

After=local-fs.target

[Service]
Type=oneshot
User=selfdef
Group=selfdef
UMask=0027

Environment=SELFDEF_PROCESS_TREE_FREEZES_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/selfdef-process-tree-freezes.prom
Environment=SELFDEF_PROCESS_TREE_FREEZES_STATE_DIR=/var/lib/selfdef/process-tree-freezes
ExecStart=/usr/share/selfdef/selfdef-process-tree-freezes-textfile.sh

SuccessExitStatus=0
TimeoutStartSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/etc/selfdef /usr/bin /usr/share/selfdef /var/lib/selfdef
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
PrivateNetwork=true
