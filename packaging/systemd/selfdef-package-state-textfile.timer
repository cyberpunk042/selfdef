[Unit]
Description=Selfdef — periodic apt/dpkg package-state observer (every 60s, 17th sibling)
Documentation=https://example.org/you/selfdef/blob/main/packaging/scripts/selfdef-package-state-textfile.sh
# 17th sibling observer timer. Sibling cadences: 60s/70s/90s/120s/
# 150s/180s/210s/240s/270s/300s/330s/360s/390s/420s/450s/480s/510s
# — 17 distinct boot offsets.

[Timer]
OnBootSec=510s
OnUnitActiveSec=60s
AccuracySec=5s
RandomizedDelaySec=10s
Unit=selfdef-package-state-textfile.service

[Install]
WantedBy=timers.target
