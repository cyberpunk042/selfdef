#!/bin/sh
# postinst script for selfdef-daemon
# https://www.debian.org/doc/debian-policy/ch-maintainerscripts.html
set -e

case "$1" in
    configure)
        # System user
        if ! getent passwd selfdef >/dev/null; then
            adduser --system --group --no-create-home \
                    --home /var/lib/selfdef \
                    --shell /usr/sbin/nologin \
                    --gecos "selfdef daemon" \
                    selfdef
        fi

        # State and log dirs
        for d in /var/lib/selfdef /var/log/selfdef; do
            mkdir -p "$d"
            chown selfdef:selfdef "$d"
            chmod 0750 "$d"
        done

        # Config dir
        mkdir -p /etc/selfdef
        chown root:selfdef /etc/selfdef
        chmod 0750 /etc/selfdef

        # Secrets dir (notification tokens etc.)
        mkdir -p /etc/selfdef/secrets
        chown root:selfdef /etc/selfdef/secrets
        chmod 0750 /etc/selfdef/secrets

        # If no config exists yet, drop the example
        if [ ! -f /etc/selfdef/selfdef.toml ] \
           && [ -f /usr/share/selfdef/selfdef.toml.example ]; then
            cp /usr/share/selfdef/selfdef.toml.example /etc/selfdef/selfdef.toml
            chown root:selfdef /etc/selfdef/selfdef.toml
            chmod 0640 /etc/selfdef/selfdef.toml
        fi

        # AppArmor profile reload (if installed)
        if [ -x /sbin/apparmor_parser ] \
           && [ -f /etc/apparmor.d/usr.bin.selfdefd ]; then
            apparmor_parser -r /etc/apparmor.d/usr.bin.selfdefd || true
        fi

        # MS046 / SDD-027: install friction-audit script + sovereign-guard
        # systemd unit. Idempotent — re-running configure re-asserts both.
        if [ -f /usr/share/selfdef/friction-audit.sh ]; then
            install -m 0755 -o root -g root \
                /usr/share/selfdef/friction-audit.sh \
                /usr/local/bin/friction-audit
            # MS046 R10803: chattr +i to lock the script after install.
            # Best-effort — fails silently on filesystems without chattr.
            chattr +i /usr/local/bin/friction-audit 2>/dev/null || true
            # Pre-create OCSF jsonl + ring buffer dirs with right perms.
            mkdir -p /var/log/selfdef /var/cache/selfdef/friction-audit/ring
            chown selfdef:selfdef /var/log/selfdef /var/cache/selfdef \
                /var/cache/selfdef/friction-audit \
                /var/cache/selfdef/friction-audit/ring 2>/dev/null || true
            chmod 0750 /var/cache/selfdef /var/cache/selfdef/friction-audit \
                /var/cache/selfdef/friction-audit/ring 2>/dev/null || true
        fi
        if [ -f /usr/share/selfdef/sovereign-guard.service ]; then
            install -m 0644 -o root -g root \
                /usr/share/selfdef/sovereign-guard.service \
                /etc/systemd/system/sovereign-guard.service
        fi

        # MS047 / SDD-028: install sovereign-perimeter Tetragon TracingPolicy
        # + create operator-extension dir + perimeter cache dirs. Idempotent.
        if [ -f /usr/share/selfdef/sovereign-perimeter.yaml ]; then
            mkdir -p /etc/tetragon/tracing-policies
            install -m 0644 -o root -g root \
                /usr/share/selfdef/sovereign-perimeter.yaml \
                /etc/tetragon/tracing-policies/sovereign-perimeter.yaml
            # MS047 R11045 / SDD-028 §Deliverable 1: lock the YAML after
            # install. Operators extend via /etc/selfdef/perimeter-extensions/
            # (out-of-band, MS003-signed), not by editing this file.
            chattr +i /etc/tetragon/tracing-policies/sovereign-perimeter.yaml \
                2>/dev/null || true
            # Operator-extension manifest drop dir (MS003-signed JSON).
            mkdir -p /etc/selfdef/perimeter-extensions
            chown root:selfdef /etc/selfdef/perimeter-extensions
            chmod 0750 /etc/selfdef/perimeter-extensions
            # Perimeter ring buffer + ZFS log bridge dirs.
            mkdir -p /var/cache/selfdef/perimeter/ring \
                     /var/log/selfdef
            chown selfdef:selfdef /var/cache/selfdef/perimeter \
                /var/cache/selfdef/perimeter/ring 2>/dev/null || true
            chmod 0750 /var/cache/selfdef/perimeter \
                /var/cache/selfdef/perimeter/ring 2>/dev/null || true
            # Tetragon hot-reload: if Tetragon is running, signal it to
            # reload tracing policies. Best-effort — Tetragon's own
            # file-watcher picks up new policies in most configurations.
            if [ -d /run/systemd/system ] \
               && systemctl is-active tetragon.service >/dev/null 2>&1; then
                systemctl reload tetragon.service 2>/dev/null \
                    || systemctl kill -s HUP tetragon.service 2>/dev/null \
                    || true
            fi
        fi

        # MS044 / SDD-029: install Guardian Daemon systemd unit + create
        # ZFS audit log dir if mountpoint present. Idempotent.
        if [ -f /usr/share/selfdef/selfdef-guardian.service ]; then
            install -m 0644 -o root -g root \
                /usr/share/selfdef/selfdef-guardian.service \
                /etc/systemd/system/selfdef-guardian.service
            # Guardian ring buffer + OCSF log dirs.
            mkdir -p /var/cache/selfdef/guardian/ring /var/log/selfdef
            chown selfdef:selfdef /var/cache/selfdef/guardian \
                /var/cache/selfdef/guardian/ring 2>/dev/null || true
            chmod 0750 /var/cache/selfdef/guardian \
                /var/cache/selfdef/guardian/ring 2>/dev/null || true
            # Pre-create the ZFS audit log directory ONLY if /mnt/vault
            # is already a mountpoint (operator-controlled). Don't make
            # /mnt/vault/context on bare filesystems — Guardian's
            # RealEffector::append_audit_log will create it on first
            # write anyway when the dataset is present.
            if mountpoint -q /mnt/vault 2>/dev/null; then
                mkdir -p /mnt/vault/context
            fi
        fi

        # MS048 / SDD-031: install Goldilocks Scheduler systemd unit +
        # pre-create ring buffer + OCSF log dirs. Idempotent.
        if [ -f /usr/share/selfdef/selfdef-scheduler.service ]; then
            install -m 0644 -o root -g root \
                /usr/share/selfdef/selfdef-scheduler.service \
                /etc/systemd/system/selfdef-scheduler.service
            mkdir -p /var/cache/selfdef/scheduler/ring /var/log/selfdef
            chown selfdef:selfdef /var/cache/selfdef/scheduler \
                /var/cache/selfdef/scheduler/ring 2>/dev/null || true
            chmod 0750 /var/cache/selfdef/scheduler \
                /var/cache/selfdef/scheduler/ring 2>/dev/null || true
        fi

        # systemd
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            # do NOT auto-start; let the operator enable when ready.
            # Operators wanting boot-gate enforcement run:
            #   systemctl enable --now sovereign-guard.service
            #   systemctl enable --now selfdef-guardian.service
        fi
        ;;
esac

#DEBHELPER#
exit 0
