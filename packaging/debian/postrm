#!/bin/sh
# postrm script for selfdef-daemon
set -e

case "$1" in
    purge)
        # On purge, remove state and user. Config is removed by dpkg.
        rm -rf /var/lib/selfdef /var/log/selfdef /var/cache/selfdef
        # MS046 / SDD-027: remove friction-audit + sovereign-guard.
        # chattr -i first or rm fails on chattr +i'd files.
        if [ -f /usr/local/bin/friction-audit ]; then
            chattr -i /usr/local/bin/friction-audit 2>/dev/null || true
            rm -f /usr/local/bin/friction-audit
        fi
        if [ -d /run/systemd/system ] \
           && [ -f /etc/systemd/system/sovereign-guard.service ]; then
            systemctl disable sovereign-guard.service 2>/dev/null || true
            systemctl stop sovereign-guard.service 2>/dev/null || true
        fi
        rm -f /etc/systemd/system/sovereign-guard.service
        rm -rf /etc/systemd/system/sovereign-guard.service.d
        # MS047 / SDD-028: remove sovereign-perimeter TracingPolicy +
        # extension manifest dir. chattr -i first.
        if [ -f /etc/tetragon/tracing-policies/sovereign-perimeter.yaml ]; then
            chattr -i /etc/tetragon/tracing-policies/sovereign-perimeter.yaml \
                2>/dev/null || true
            rm -f /etc/tetragon/tracing-policies/sovereign-perimeter.yaml
            # Tell Tetragon to reload so the kernel-fence comes down.
            if [ -d /run/systemd/system ] \
               && systemctl is-active tetragon.service >/dev/null 2>&1; then
                systemctl reload tetragon.service 2>/dev/null \
                    || systemctl kill -s HUP tetragon.service 2>/dev/null \
                    || true
            fi
        fi
        rm -rf /etc/selfdef/perimeter-extensions
        # MS044 / SDD-029: disable + stop + remove Guardian systemd unit.
        if [ -d /run/systemd/system ] \
           && [ -f /etc/systemd/system/selfdef-guardian.service ]; then
            systemctl disable selfdef-guardian.service 2>/dev/null || true
            systemctl stop selfdef-guardian.service 2>/dev/null || true
        fi
        rm -f /etc/systemd/system/selfdef-guardian.service
        rm -rf /etc/systemd/system/selfdef-guardian.service.d
        # MS048 / SDD-031: disable + stop + remove Scheduler systemd unit.
        if [ -d /run/systemd/system ] \
           && [ -f /etc/systemd/system/selfdef-scheduler.service ]; then
            systemctl disable selfdef-scheduler.service 2>/dev/null || true
            systemctl stop selfdef-scheduler.service 2>/dev/null || true
        fi
        rm -f /etc/systemd/system/selfdef-scheduler.service
        rm -rf /etc/systemd/system/selfdef-scheduler.service.d
        # M060 cli-mirror-emit: disable + stop the producer one-shot so
        # purge leaves no orphaned timer / next-boot trigger pointing
        # at the (now-missing) selfdefctl binary. The unit file itself
        # is shipped via /lib/systemd/system (managed by dpkg, not us);
        # any operator drop-in overrides under /etc/systemd/system
        # belong to the operator and we do NOT delete those. The
        # resident store /var/lib/selfdef/cli-mirror.json is purged by
        # the broader /var/lib/selfdef wipe above.
        if [ -d /run/systemd/system ] \
           && [ -f /lib/systemd/system/selfdef-cli-mirror-emit.service ]; then
            systemctl disable selfdef-cli-mirror-emit.service 2>/dev/null || true
            systemctl stop selfdef-cli-mirror-emit.service 2>/dev/null || true
        fi
        rm -rf /etc/systemd/system/selfdef-cli-mirror-emit.service.d
        # M060 cli-mirror-doctor timer+service: same shape — disable
        # the timer first (so it stops scheduling), then stop both
        # units. The textfile under /var/lib/node_exporter/ is
        # operator-controlled (we did NOT create the dir; we just
        # wrote into it), so we explicitly remove only the file we
        # produced, not the dir.
        if [ -d /run/systemd/system ] \
           && [ -f /lib/systemd/system/selfdef-cli-mirror-doctor.timer ]; then
            systemctl disable selfdef-cli-mirror-doctor.timer 2>/dev/null || true
            systemctl stop selfdef-cli-mirror-doctor.timer 2>/dev/null || true
            systemctl disable selfdef-cli-mirror-doctor.service 2>/dev/null || true
            systemctl stop selfdef-cli-mirror-doctor.service 2>/dev/null || true
        fi
        rm -rf /etc/systemd/system/selfdef-cli-mirror-doctor.service.d
        rm -rf /etc/systemd/system/selfdef-cli-mirror-doctor.timer.d
        rm -f /var/lib/node_exporter/textfile_collector/selfdef-cli-mirror.prom
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        if getent passwd selfdef >/dev/null; then
            deluser --system selfdef >/dev/null 2>&1 || true
        fi
        if getent group selfdef >/dev/null; then
            delgroup --system selfdef >/dev/null 2>&1 || true
        fi
        ;;
    remove)
        # MS046 / SDD-027: stop sovereign-guard on remove (without purge);
        # leave the script + unit file for upgrade reinstall.
        if [ -d /run/systemd/system ] \
           && [ -f /etc/systemd/system/sovereign-guard.service ]; then
            systemctl stop sovereign-guard.service 2>/dev/null || true
        fi
        # MS044 / SDD-029: stop Guardian on remove (without purge);
        # leave the unit file for upgrade reinstall.
        if [ -d /run/systemd/system ] \
           && [ -f /etc/systemd/system/selfdef-guardian.service ]; then
            systemctl stop selfdef-guardian.service 2>/dev/null || true
        fi
        # MS048 / SDD-031: stop Scheduler on remove (without purge);
        # leave the unit file for upgrade reinstall.
        if [ -d /run/systemd/system ] \
           && [ -f /etc/systemd/system/selfdef-scheduler.service ]; then
            systemctl stop selfdef-scheduler.service 2>/dev/null || true
        fi
        # M060 cli-mirror-emit: stop the producer one-shot on remove
        # so it doesn't fire post-uninstall (the ExecStart references
        # /usr/bin/selfdefctl which dpkg will remove). The unit file
        # itself stays in /lib/systemd/system for reinstall-as-upgrade
        # (dpkg manages that path).
        if [ -d /run/systemd/system ] \
           && [ -f /lib/systemd/system/selfdef-cli-mirror-emit.service ]; then
            systemctl stop selfdef-cli-mirror-emit.service 2>/dev/null || true
        fi
        # M060 cli-mirror-doctor timer: stop on remove so the timer
        # doesn't fire (ExecStart references the about-to-be-removed
        # selfdefctl) — but leave enabled state alone so the
        # reinstall=upgrade contract holds.
        if [ -d /run/systemd/system ] \
           && [ -f /lib/systemd/system/selfdef-cli-mirror-doctor.timer ]; then
            systemctl stop selfdef-cli-mirror-doctor.timer 2>/dev/null || true
            systemctl stop selfdef-cli-mirror-doctor.service 2>/dev/null || true
        fi
        ;;
    upgrade|deconfigure|failed-upgrade|abort-install|abort-upgrade|disappear)
        # nothing to do
        ;;
esac

#DEBHELPER#
exit 0
