[Unit]
Description=selfdef kernel key-upcall handler (request-key.conf) delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/request-key-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/request-key-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
