# selfdef request-key-watchdog — boot+34min + daily 08:55.
# Extends the staggered ladder after securetty (08:50). Boot catch
# confirms the key-upcall handlers after a restart (a rogue callout
# fires on the next kernel key request).

[Unit]
Description=selfdef kernel key-upcall handler delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/request-key-watchdog/README.md

[Timer]
OnBootSec=34min
OnCalendar=*-*-* 08:55:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-request-key.service

[Install]
WantedBy=timers.target
