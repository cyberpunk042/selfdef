[Unit]
Description=selfdef MIT Kerberos [plugins] module-load delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/krb5-plugins-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/krb5-plugins-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
