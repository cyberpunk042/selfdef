# selfdef modules-load-watchdog — boot+26min + daily 08:15.
# Extends the staggered ladder after dbus-service (08:10). Boot
# catch confirms the auto-load config after a restart (the listed
# modules load at the start of the next boot).

[Unit]
Description=selfdef kernel-module auto-load config delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/modules-load-watchdog/README.md

[Timer]
OnBootSec=26min
OnCalendar=*-*-* 08:15:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-modules-load.service

[Install]
WantedBy=timers.target
