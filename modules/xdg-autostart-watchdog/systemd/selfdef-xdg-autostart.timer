# selfdef xdg-autostart-watchdog — boot+30min + daily 08:35.
# Extends the staggered ladder after ssh-client-config (08:30).
# Boot catch confirms the autostart entries after a restart (an
# entry fires on the next graphical login).

[Unit]
Description=selfdef XDG desktop autostart delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/xdg-autostart-watchdog/README.md

[Timer]
OnBootSec=30min
OnCalendar=*-*-* 08:35:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-xdg-autostart.service

[Install]
WantedBy=timers.target
