# selfdef rkhunter-cron — service unit.
#
# Runs the wrapper script which invokes rkhunter --check + emits
# a structured finding event tagged 'selfdef-rkhunter'.

[Unit]
Description=selfdef rkhunter known-rootkit-signature scan
Documentation=https://github.com/cyberpunk042/selfdef modules/rkhunter-cron/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/rkhunter-check.sh
# rkhunter needs to read system paths broadly — defense-in-depth
# at the systemd layer (script is read-only against the host).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/rkhunter /var/log/rkhunter /dev/log
# rkhunter is CPU-bound on file scanning — nice + idle so the
# operator stays responsive during the daily scan.
Nice=15
IOSchedulingClass=idle
