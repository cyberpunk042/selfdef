[Unit]
Description=selfdef PAM-config delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/pam-config-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/pam-config-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=12
TimeoutStartSec=2m
