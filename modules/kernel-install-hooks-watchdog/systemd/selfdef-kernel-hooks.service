[Unit]
Description=selfdef kernel-package install-hook delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/kernel-install-hooks-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/kernel-install-hooks-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
