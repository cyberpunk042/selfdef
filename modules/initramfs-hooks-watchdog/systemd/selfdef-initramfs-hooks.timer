# selfdef initramfs-hooks-watchdog — boot+50min + daily 10:15.
# Extends the staggered ladder after kernel-hooks (10:10). An
# injected initramfs script only takes effect on the next
# update-initramfs (kernel update / manual rebuild) and runs at the
# following boot, so the daily catch bounds dwell time; the boot
# catch confirms the script set after a restart.

[Unit]
Description=selfdef initramfs hook + boot-script delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/initramfs-hooks-watchdog/README.md

[Timer]
OnBootSec=50min
OnCalendar=*-*-* 10:15:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-initramfs-hooks.service

[Install]
WantedBy=timers.target
