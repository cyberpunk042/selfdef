[Unit]
Description=selfdef initramfs hook + boot-script delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/initramfs-hooks-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/initramfs-hooks-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
