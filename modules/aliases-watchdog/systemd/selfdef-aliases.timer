# selfdef aliases-watchdog — boot+78min + daily 12:45.
# Extends the staggered ladder after postfix-exec (12:40). A planted
# pipe alias fires the next time mail is delivered to that alias
# (deliverable on demand by sending mail to it), so the daily catch
# bounds dwell time; the boot catch confirms the alias set after a
# restart.

[Unit]
Description=selfdef mail aliases pipe/include delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/aliases-watchdog/README.md

[Timer]
OnBootSec=78min
OnCalendar=*-*-* 12:45:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-aliases.service

[Install]
WantedBy=timers.target
