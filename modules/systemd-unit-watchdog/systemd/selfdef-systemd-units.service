[Unit]
Description=selfdef enabled-systemd-unit delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/systemd-unit-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/systemd-unit-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=3m
