# selfdef systemd-unit-watchdog — daily 06:10 + boot.
# Extends the staggered ladder after mount-options (06:05).
# Boot catch confirms the enabled-unit set after every
# restart (an enabled backdoor service shows at boot).

[Unit]
Description=selfdef enabled-systemd-unit delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/systemd-unit-watchdog/README.md

[Timer]
OnBootSec=10min
OnCalendar=*-*-* 06:10:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-systemd-units.service

[Install]
WantedBy=timers.target
