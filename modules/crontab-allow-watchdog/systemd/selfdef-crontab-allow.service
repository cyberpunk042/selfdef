[Unit]
Description=selfdef cron/at allow-roster delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/crontab-allow-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/crontab-allow-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=30s
