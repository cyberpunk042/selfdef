[Unit]
Description=selfdef OpenSSL config engine/provider-load delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/openssl-conf-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/openssl-conf-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
