# selfdef audit-rules — paranoid profile.
#
# Adds to the base profile: every exec, every ptrace, every uid/gid
# change, cron config writes. Measurable audit-overhead — operator
# trades performance for deep telemetry.
#
# Installed at /etc/audit/rules.d/50-selfdef-paranoid.rules.

# === Universal exec audit (T1059) ===
# Every execve / execveat call. Generates the multi-line SYSCALL+
# EXECVE pair the auditd collector's deferred multi-line parser
# will eventually correlate. Today the collector falls back to
# generic events for both lines; the data is still on disk.
-a always,exit -F arch=b64 -S execve   -k selfdef-exec
-a always,exit -F arch=b64 -S execveat -k selfdef-exec

# === ptrace surveillance (T1055.008, T1003.001 LSASS-equiv) ===
# Any process attaching ptrace to another is high-signal — debugger
# legitimately, exploit attaching to a SUID binary's image
# illegitimately.
-a always,exit -F arch=b64 -S ptrace -k selfdef-ptrace

# === UID/GID change syscalls ===
# Catches every setuid/setgid/setreuid/setregid invocation. SUID
# binaries' permission elevation paths surface here.
-a always,exit -F arch=b64 -S setuid    -k selfdef-setid
-a always,exit -F arch=b64 -S setgid    -k selfdef-setid
-a always,exit -F arch=b64 -S setreuid  -k selfdef-setid
-a always,exit -F arch=b64 -S setregid  -k selfdef-setid
-a always,exit -F arch=b64 -S setresuid -k selfdef-setid
-a always,exit -F arch=b64 -S setresgid -k selfdef-setid

# === Cron / scheduled-task config writes (T1053.003) ===
-w /etc/cron.d        -p wa -k selfdef-cron
-w /etc/cron.daily    -p wa -k selfdef-cron
-w /etc/cron.hourly   -p wa -k selfdef-cron
-w /etc/cron.weekly   -p wa -k selfdef-cron
-w /etc/cron.monthly  -p wa -k selfdef-cron
-w /etc/crontab       -p wa -k selfdef-cron
-w /var/spool/cron    -p wa -k selfdef-cron

# === systemd unit dir writes (persistence T1543.002) ===
-w /etc/systemd/system -p wa -k selfdef-systemd-unit
-w /lib/systemd/system -p wa -k selfdef-systemd-unit
