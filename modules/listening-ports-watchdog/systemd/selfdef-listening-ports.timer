# selfdef listening-ports-watchdog — boot+5min + every 6h.
# Listening ports can appear any time a backdoor binds — a
# 6h cadence balances detection latency against noise. Boot
# catch confirms the listen-set after every restart.

[Unit]
Description=selfdef listening-ports delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/listening-ports-watchdog/README.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
RandomizedDelaySec=5min
Persistent=true
Unit=selfdef-listening-ports.service

[Install]
WantedBy=timers.target
