[Unit]
Description=selfdef shell-init scripts delta + injection-pattern scan
Documentation=https://github.com/cyberpunk042/selfdef modules/shell-init-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/shell-init-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
