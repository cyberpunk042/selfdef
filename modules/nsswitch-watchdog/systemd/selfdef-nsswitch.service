[Unit]
Description=selfdef Name Service Switch (nsswitch.conf) delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/nsswitch-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/nsswitch-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
