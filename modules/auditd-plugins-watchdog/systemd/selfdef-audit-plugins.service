[Unit]
Description=selfdef auditd dispatcher-plugin delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/auditd-plugins-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/auditd-plugins-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
