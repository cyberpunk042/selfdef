# selfdef ld-preload-watchdog — service unit.

[Unit]
Description=selfdef LD_PRELOAD userland-rootkit scan
Documentation=https://github.com/cyberpunk042/selfdef modules/ld-preload-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/ld-preload-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log
Nice=15
TimeoutStartSec=2m
