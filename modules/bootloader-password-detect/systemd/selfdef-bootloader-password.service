# selfdef bootloader-password-detect — service unit.

[Unit]
Description=selfdef GRUB2 bootloader password verification
Documentation=https://github.com/cyberpunk042/selfdef modules/bootloader-password-detect/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/bootloader-password-detect.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log
Nice=10
TimeoutStartSec=1m
