# selfdef bootloader-password-detect — at boot + weekly.
#
# At boot (post-fs): catches a freshly-regenerated grub.cfg
# that may have lost the password directive (operator ran
# grub-mkconfig without the right include).
# Weekly Sun-07:00: catches operator-edits since last week.

[Unit]
Description=selfdef GRUB2 bootloader password verification timer
Documentation=https://github.com/cyberpunk042/selfdef modules/bootloader-password-detect/README.md

[Timer]
OnBootSec=10min
OnCalendar=Sun *-*-* 07:00:00
RandomizedDelaySec=15m
Persistent=true
Unit=selfdef-bootloader-password.service

[Install]
WantedBy=timers.target
