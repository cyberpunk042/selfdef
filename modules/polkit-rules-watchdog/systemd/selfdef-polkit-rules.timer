# selfdef polkit-rules-watchdog — boot+23min + daily 08:00.
# Extends the staggered ladder after limits-conf (07:55). Boot
# catch confirms the polkit rules after a restart (polkitd reloads
# rules dynamically, so a dropped rule is live immediately).

[Unit]
Description=selfdef polkit authorization rules delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/polkit-rules-watchdog/README.md

[Timer]
OnBootSec=23min
OnCalendar=*-*-* 08:00:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-polkit-rules.service

[Install]
WantedBy=timers.target
