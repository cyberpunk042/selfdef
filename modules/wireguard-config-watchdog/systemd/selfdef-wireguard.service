[Unit]
Description=selfdef WireGuard config (PostUp hook + key-exposure) delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/wireguard-config-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/wireguard-config-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
