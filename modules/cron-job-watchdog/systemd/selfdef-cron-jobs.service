# selfdef cron-job-watchdog — service unit.

[Unit]
Description=selfdef scheduled-task delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/cron-job-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/cron-job-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=5m
