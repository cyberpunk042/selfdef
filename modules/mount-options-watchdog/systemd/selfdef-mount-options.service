# selfdef mount-options-watchdog — service unit.

[Unit]
Description=selfdef mount-options hardening-flag verification
Documentation=https://github.com/cyberpunk042/selfdef modules/mount-options-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/mount-options-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log
Nice=10
TimeoutStartSec=1m
