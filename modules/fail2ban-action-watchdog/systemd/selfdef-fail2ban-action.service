[Unit]
Description=selfdef fail2ban action-definition delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/fail2ban-action-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/fail2ban-action-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
