# Prometheus alerting rules for the selfdef four-watchdog set.
# Managed by the `observability` module's apply.sh — drop this file
# under /etc/prometheus/rules.d/ (or your runtime's equivalent) and
# reload Prometheus.
#
# Series consumed: emitted by selfdef-api/metrics::watchdog_metrics
# (selfdef-api crate). See ARCHITECTURE.md § "Four-watchdog set"
# + the per-watchdog runbooks in
# ~/devops-solutions-information-hub/wiki/runbooks/.

groups:
  - name: selfdef-four-watchdog
    interval: 30s
    rules:
      # ----- MS046 friction-audit (hardware-integrity gate) -----
      - alert: SelfdefFrictionAuditFailingGate
        expr: selfdef_friction_audit_failing_total > 0
        for: 1m
        labels:
          severity: critical
          watchdog: friction-audit
          ms: MS046
        annotations:
          summary: "friction-audit: {{ $value }} gate(s) failing on {{ $labels.instance }}"
          description: "MS046 hardware-integrity gate has gate(s) in Fail status with no operator override honoring. Boot-time hardware integrity violated; container runtimes will refuse to start. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/friction-audit-pcie.md"

      # ----- MS047 perimeter (kernel-fence) -----
      - alert: SelfdefPerimeterSigkill
        expr: selfdef_perimeter_sigkills_total > 0
        for: 0m
        labels:
          severity: warning
          watchdog: perimeter
          ms: MS047
        annotations:
          summary: "perimeter: {{ $value }} SIGKILL verdict(s) on {{ $labels.instance }}"
          description: "MS047 kernel-fence killed a process attempting to execve outside the verbatim sain-01 §6 allowlist. Could be operator workflow needing an extension OR a probe by something hostile. Investigate via selfdefctl perimeter history."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/perimeter-sigkill-investigation.md"

      - alert: SelfdefPerimeterPolicyMissing
        expr: selfdef_perimeter_policy_present == 0
        for: 2m
        labels:
          severity: critical
          watchdog: perimeter
          ms: MS047
        annotations:
          summary: "perimeter: sovereign-perimeter.yaml not present on {{ $labels.instance }}"
          description: "MS047 TracingPolicy YAML missing from /etc/tetragon/tracing-policies/. Kernel-fence is OFF — host can execve anything. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/perimeter-policy-load-failure.md"

      - alert: SelfdefPerimeterChainBroken
        expr: selfdef_perimeter_audit_chain_events == -1
        for: 1m
        labels:
          severity: critical
          watchdog: perimeter
          ms: MS047
        annotations:
          summary: "perimeter: OCSF audit chain broken on {{ $labels.instance }}"
          description: "MS047 SHA-256 audit chain integrity verification failed. Storage corruption, log tampering, or concurrent writer. CRITICAL — investigate per runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/perimeter-audit-log-corruption.md"

      # ----- MS044 guardian (Tetragon supervisor) -----
      - alert: SelfdefGuardianFailedResponse
        expr: selfdef_guardian_failed_responses_total > 0
        for: 0m
        labels:
          severity: critical
          watchdog: guardian
          ms: MS044
        annotations:
          summary: "guardian: {{ $value }} verdict(s) with failed response step on {{ $labels.instance }}"
          description: "MS044 supervisor Responder had at least one of its 3 steps (SIGKILL / ZFS audit-append / /dev/console BEL) Failed. Supervisor response degraded; investigate via selfdefctl guardian history."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/guardian-console-alert-investigation.md"

      - alert: SelfdefGuardianTetragonSocketMissing
        expr: selfdef_guardian_tetragon_socket_present == 0
        for: 2m
        labels:
          severity: warning
          watchdog: guardian
          ms: MS044
        annotations:
          summary: "guardian: Tetragon UNIX socket missing on {{ $labels.instance }}"
          description: "MS044 guardian can't ingest Tetragon events. Supervisor-tier observability + cross-cgroup containment + audit chain silent until Tetragon comes back. The in-kernel perimeter (MS047) still fires."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/guardian-socket-unreachable.md"

      - alert: SelfdefGuardianChainBroken
        expr: selfdef_guardian_audit_chain_events == -1
        for: 1m
        labels:
          severity: critical
          watchdog: guardian
          ms: MS044
        annotations:
          summary: "guardian: OCSF audit chain broken on {{ $labels.instance }}"
          description: "MS044 SHA-256 audit chain integrity verification failed. Storage corruption, log tampering, or concurrent writer. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/guardian-audit-log-corruption.md"

      # ----- MS048 scheduler (Goldilocks routing layer) -----
      - alert: SelfdefSchedulerSustainedBackpressure
        # Backpressured-decisions count rising > 0 for 10m = sustained
        # resource pressure. Operator should investigate which surface.
        expr: selfdef_scheduler_backpressured_decisions_total > 0
        for: 10m
        labels:
          severity: warning
          watchdog: scheduler
          ms: MS048
        annotations:
          summary: "scheduler: sustained backpressure on {{ $labels.instance }}"
          description: "MS048 Goldilocks scheduler has been making backpressured routing decisions continuously for 10m. Some resource (Blackwell VRAM / 3090 / CPU / RAM / IO / human-gate) is sustained-pressured. Investigate via selfdefctl scheduler show --json."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/scheduler-backpressure-stuck-open.md"

      - alert: SelfdefSchedulerChainBroken
        expr: selfdef_scheduler_audit_chain_events == -1
        for: 1m
        labels:
          severity: critical
          watchdog: scheduler
          ms: MS048
        annotations:
          summary: "scheduler: audit chain broken on {{ $labels.instance }}"
          description: "MS048 SHA-256 audit chain integrity verification failed. Storage corruption, log tampering, or concurrent writer. Counterfactual replay no longer trustworthy. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/scheduler-audit-log-corruption.md"

      # ----- MS011 Z-10 storage thresholds -----
      - alert: SelfdefStorageMountYellow
        expr: selfdef_storage_mount_used_pct >= 70 < 90
        for: 5m
        labels:
          severity: warning
          ms: MS011
        annotations:
          summary: "storage: mount {{ $labels.mountpoint }} at {{ $value }}% (>=70%, sustained 5m)"
          description: "Mount {{ $labels.mountpoint }} ({{ $labels.fstype }}) has been at 70-89% used for >5m. Investigate fill rate + plan capacity per runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/storage-degraded.md"

      - alert: SelfdefStorageMountRed
        expr: selfdef_storage_mount_used_pct >= 90
        for: 1m
        labels:
          severity: critical
          ms: MS011
        annotations:
          summary: "storage: mount {{ $labels.mountpoint }} CRITICAL at {{ $value }}% (>=90%)"
          description: "Mount {{ $labels.mountpoint }} ({{ $labels.fstype }}) at >=90% used. Audit-chain append failures imminent for any chain on this mount. Recover per runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/storage-degraded.md"

  # ----- M060 cross-repo mirror-export loop -----
  # The selfdef daemon publishes 10 typed-mirror artifacts every 30s into
  # [deployment].selfdef_mirror_dir (default /run/sovereign-os/selfdef-
  # mirror/). selfdef-api exposes per-artifact publish counters + last-
  # publish-time gauges at /metrics. Alerts fire when any publisher fails
  # (any selfdef_m060_mirror_publish_total{result="failed"} > 0) or when
  # a successful publish hasn't occurred recently (time() -
  # selfdef_m060_mirror_last_publish_unix > threshold). Honest-offline
  # artifacts (operator-issued domains the operator hasn't onboarded yet)
  # don't contribute — `record_outcome` skips them per design.
  - name: selfdef-m060-mirror-export
    interval: 30s
    rules:
      - alert: SelfdefM060PublishFailing
        # Any artifact has a failed publish in the last 5 minutes.
        # Per-artifact granularity in $labels.artifact lets the operator
        # see WHICH publisher is wedged without paging on every artifact.
        expr: |
          increase(
            selfdef_m060_mirror_publish_total{result="failed"}[5m]
          ) > 0
        for: 2m
        labels:
          severity: warning
          subsystem: m060-mirror-export
          m060_failure: publish
        annotations:
          summary: "M060 mirror publish failing for artifact {{ $labels.artifact }} on {{ $labels.instance }}"
          description: >
            The selfdef daemon's mirror_export_loop attempted to publish
            {{ $labels.artifact }} but the post-call outcome check found
            the mirror file missing or stale. Indicates a write failure
            (disk full, permission error, ENOENT on the mirror_dir) OR a
            registry-load failure. Check `journalctl -u selfdefd | grep
            "mirror export"` for the specific warn line; the publish_*
            function logs the underlying error before returning.
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/m060-mirror-export-publish-anomalies.md"

      - alert: SelfdefM060PublishStale
        # No successful publish for any operator-issued artifact in 10
        # minutes (= 20 ticks of the 30s loop). Don't fire if the gauge
        # is absent (honest-offline; operator hasn't onboarded the
        # domain). The check `absent()` defends against false-positives
        # at scrape-startup before the first publish lands.
        expr: |
          time() - selfdef_m060_mirror_last_publish_unix > 600
        for: 5m
        labels:
          severity: warning
          subsystem: m060-mirror-export
          m060_failure: stale
        annotations:
          summary: "M060 mirror artifact {{ $labels.artifact }} stale (>10min) on {{ $labels.instance }}"
          description: >
            Artifact {{ $labels.artifact }} has not been successfully
            republished by selfdefd's mirror_export_loop in over 10
            minutes. The export loop runs every 30s; 10m of silence on
            a single artifact while others are fresh indicates that
            artifact's publisher is wedged. Could be a registry-load
            failure on its resident store, or a partial write that the
            atomic rename never completed. Check the per-publisher warn
            logs in journalctl.
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/m060-mirror-export-publish-anomalies.md"

      - alert: SelfdefM060PublishWedged
        # Persistent fail rate: failed > 5 in 30m means the publisher
        # has been failing every tick for 30 min straight. Operator
        # intervention required (vs single-tick transient blips).
        expr: |
          increase(
            selfdef_m060_mirror_publish_total{result="failed"}[30m]
          ) > 5
        for: 5m
        labels:
          severity: critical
          subsystem: m060-mirror-export
          m060_failure: wedged
        annotations:
          summary: "M060 mirror publisher WEDGED on artifact {{ $labels.artifact }} on {{ $labels.instance }}"
          description: >
            Artifact {{ $labels.artifact }} has failed to publish more
            than 5 times in 30 minutes. The export loop ticks every 30s
            (= max 60 ticks per 30m), so >5 failures means the
            publisher is failing every several ticks. Persistent state —
            no longer a transient blip. Likely root causes: mirror_dir
            permission denied, disk full, atomic-rename failing on the
            target filesystem, corrupt resident store. Investigate.
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/m060-mirror-export-publish-anomalies.md"

  # ----- Detection-watchdog finding stream (SDD-062 routed) -----
  # The ~46 host detection-watchdogs emit alert-tier findings (planted
  # exec / writable LOLBin / injection pattern / writable config / a
  # module_lib_missing fail-loud) that the selfdef_watchdog_alert Sigma
  # rule promotes to High Detection Findings, counted per rule by
  # selfdef-api metrics::findings_by_rule. This pages the metrics path,
  # complementing the in-process notifier chain.
  - name: selfdef-detection-watchdog
    interval: 30s
    rules:
      - alert: SelfdefWatchdogAlertFinding
        expr: increase(selfdef_findings_by_rule_total{rule="selfdef watchdog alert-tier finding"}[10m]) > 0
        for: 0m
        labels:
          severity: warning
          watchdog: detection-watchdog
        annotations:
          summary: "detection-watchdog alert finding on {{ $labels.instance }} ({{ $value }} in 10m)"
          description: "A selfdef host detection-watchdog emitted an alert-tier finding routed via the selfdef_watchdog_alert Sigma rule (SDD-062). The tag-prefix rule covers both watchdog axes: the exec/injection axis (a planted execute()/RUN/Exec under a writable root, an injection pattern, a writable/non-root config, or a module_lib_missing fail-loud) AND the integrity/baseline axis (a new setuid binary or file-capability grant, a + rhosts trust, a root-login TTY widen, a rogue NSS source, a weakened kernel sysctl, …). Identify the watchdog + axis from the selfdef-* journald SyslogIdentifier and compare against its baseline. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/selfdef-watchdog-alert-finding.md"

  # ----- meta-observability: the /metrics path itself degrading -----
  # selfdef_ingest_lag_events_total counts events the metrics-ingest
  # subscriber MISSED because the in-process bus broadcast over-subscribed.
  # When non-zero, every counter-based alert above is reading an
  # under-counted series — so this warns that the observability itself is
  # degraded (F-2026-084). Dashboarded at panel id=132 (SD-API health row).
  - name: selfdef-meta-observability
    interval: 30s
    rules:
      - alert: SelfdefMetricsIngestLag
        expr: increase(selfdef_ingest_lag_events_total[10m]) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "selfdef metrics ingest lag on {{ $labels.instance }} ({{ $value }} events dropped in 10m)"
          description: "The selfdef-api metrics-ingest subscriber missed {{ $value }} bus events in the last 10m (selfdef_ingest_lag_events_total rising) — the in-process bus broadcast is over-subscribed, so selfdef_events_* / selfdef_findings_* counters now UNDER-count reality and every counter-based alert here may not fire for events that landed in a dropped batch. Detection still happens (correlator + responder subscribe independently); it's the observability that's degraded. Remediate the event-storm source or raise [bus] inproc_capacity. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/metrics-ingest-lag.md"

      # The correlator is a bus subscriber too: if IT lags, raw events are
      # dropped before the rules ever evaluate them (F-2026-094). That is a
      # DETECTION gap, strictly worse than ingest lag — a pattern in a dropped
      # batch produces no finding at all. Same overflow mechanism, different
      # (load-bearing) subscriber.
      - alert: SelfdefCorrelatorBusLag
        expr: increase(selfdef_correlator_lag_events_total[10m]) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "selfdef correlator bus lag on {{ $labels.instance }} ({{ $value }} raw events dropped before detection in 10m)"
          description: "The selfdef correlator subscriber missed {{ $value }} bus events in the last 10m (selfdef_correlator_lag_events_total rising) — the in-process bus broadcast over-subscribed and those raw events were NEVER run through the Sigma/correlation rules, so any detection they would have triggered did not happen. Unlike ingest lag this degrades the DEFENSE, not just the metrics: it is a detection gap proportional to the drop count, and it spikes exactly when event volume does (during an incident). Remediate the event-storm source, raise [bus] inproc_capacity, or resolve correlator CPU starvation. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/metrics-correlator-lag.md"

      # The responder is the last bus subscriber: if IT lags, findings are
      # dropped before any autonomous action fires (F-2026-094). Detection
      # happened, but no block/quarantine/notify was dispatched for those
      # findings — a RESPONSE gap.
      - alert: SelfdefResponderBusLag
        expr: increase(selfdef_responder_lag_events_total[10m]) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "selfdef responder bus lag on {{ $labels.instance }} ({{ $value }} findings dropped before any action in 10m)"
          description: "The selfdef responder subscriber missed {{ $value }} findings in the last 10m (selfdef_responder_lag_events_total rising) — the in-process bus broadcast over-subscribed and for those findings NO autonomous response fired (no block/quarantine/notify). Detection happened; the gap is between detecting and acting. An attacker flooding low-value findings to bury a high-value one under responder lag is a plausible evasion. Make the action path faster/async, raise [bus] inproc_capacity, or resolve responder CPU starvation. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/metrics-responder-lag.md"

      # The KERNEL detection source degrading — the external analog of the bus
      # lag above. Tetragon BPF map errors (`tetragon_map_errors_total`, the
      # contract-pinned metric, dashboarded but previously unalerted) rise when
      # the in-kernel detection layer is under pressure (process-cache map full,
      # map update/read failures). Under that pressure Tetragon silently drops
      # or mishandles events BEFORE selfdef ever receives them — the
      # "Tetragon-socket-dropout gotcha": unlike a vanished socket
      # (SelfdefGuardianTetragonSocketMissing, which we already alert), the
      # collector stays connected while the kernel source quietly loses fidelity,
      # so detection degrades with zero signal on selfdef's own bus. Proactive
      # warn so a degrading kernel source can't go unnoticed.
      - alert: SelfdefTetragonMapErrors
        expr: increase(tetragon_map_errors_total[10m]) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "Tetragon BPF map errors on {{ $labels.instance }} ({{ $value }} in 10m) — kernel detection source degrading"
          description: "Tetragon reported {{ $value }} BPF map errors in the last 10m (tetragon_map_errors_total rising) — the in-kernel detection layer is under pressure (process-cache map full / map op failures). Under this pressure Tetragon can silently DROP or mishandle exec/file/socket events before selfdef's collector receives them (the Tetragon-socket-dropout gotcha), so detection degrades with no signal on selfdef's own event bus. This is the external analog of the bus-lag alerts: the source itself is lossy. Investigate Tetragon resource limits (process-cache size, ringbuf/map sizing) and event volume; correlate with tetragon_events_total flattening. See runbook."
          runbook_url: "https://github.com/cyberpunk042/devops-solutions-information-hub/blob/main/wiki/runbooks/tetragon-map-errors.md"

      # The RESPONDER over-reacting — the decision-discipline circuit-breakers
      # firing. selfdef_responder_suppressed_destructive_total rises when the
      # burst-dedup or rate-cap gate suppresses a destructive action (kill /
      # quarantine / block / isolate): the daemon was about to re-fire the same
      # action on the same target, OR a destructive-action FLOOD hit the
      # per-minute cap. Suppression is the SAFE outcome (it stops the IPS
      # hammering one target or going into mass destruction), so this is a
      # proactive warn, not a page — but a sustained non-zero rate means an
      # upstream cause: an event burst, a correlation storm, a poisoned/spoofed
      # event stream, or a mis-tuned window. Series only present when a
      # deployment has enabled [responder].dedup_window_secs or
      # max_destructive_actions_per_min.
      - alert: SelfdefResponderCircuitBreakerTripped
        expr: increase(selfdef_responder_ratecap_tripped_total[10m]) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "selfdef responder rate-cap circuit-breaker tripped {{ $value }} times in 10m on {{ $labels.instance }}"
          description: "selfdef_responder_ratecap_tripped_total rose by {{ $value }} in the last 10m — the responder's GLOBAL destructive-action rate-cap (flood breaker) hit its ceiling and suppressed further kill/quarantine/block/isolate actions. This is the genuine circuit-breaker signal (routine per-target dedup is excluded — it does NOT raise this alert). Tripping is the SAFE outcome (it stops the IPS going into mass destruction during a flood), but it means destructive actions reached [responder].max_destructive_actions_per_min, so investigate the upstream cause: an event burst, a correlation storm, a poisoned/spoofed event stream, or a mis-tuned cap. Correlate with selfdef_findings_total, selfdef_responder_suppressed_destructive_total (aggregate, includes dedup), and the bus-lag series; check `journalctl -u selfdefd` for the 'rate cap reached (circuit breaker)' lines."
