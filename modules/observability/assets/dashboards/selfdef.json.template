{
  "uid": "__SELFDEF_DASHBOARD_UID__",
  "title": "__SELFDEF_DASHBOARD_TITLE__",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "tags": ["selfdef", "tetragon"],
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tetragon events / second",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(tetragon_events_total[5m]))",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tetragon kills by policy",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (policy) (rate(tetragon_msg_sigkill_total[5m]))",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Process cache utilization",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "tetragon_process_cache_size",
          "legendFormat": "entries"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Map operation errors",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum by (map, op) (rate(tetragon_map_errors_total[5m]))",
          "legendFormat": "{{map}} {{op}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "selfdef events / second by class",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (class_uid) (rate(selfdef_events_by_class_total[5m]))",
          "legendFormat": "class {{class_uid}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "selfdef findings / second by severity",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (severity_id) (rate(selfdef_findings_by_severity_total[5m]))",
          "legendFormat": "severity {{severity_id}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "selfdef hot-store size",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "selfdef_store_events",
          "legendFormat": "events"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "selfdef retention — events pruned / sec (SDD-081)",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "rate(selfdef_store_retention_pruned_total[1h])",
          "legendFormat": "pruned/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "selfdef findings / second by rule (incl. detection-watchdog alert tier, SDD-062)",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "sum by (rule) (rate(selfdef_findings_by_rule_total[5m]))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "detection-watchdog alert findings (1h)",
      "description": "Count of alert-tier host detection-watchdog findings in the last hour, across BOTH watchdog axes routed by the selfdef_watchdog_alert Sigma rule (SDD-062): the exec/injection axis (planted exec / writable LOLBin / injection / writable config / module_lib_missing) and the integrity/baseline axis (new setuid binary / file-cap grant / + rhosts trust / securetty widen / rogue NSS source / weakened sysctl). >0 fires SelfdefWatchdogAlertFinding — see the selfdef-watchdog-alert-finding runbook.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "sum(increase(selfdef_findings_by_rule_total{rule=\"selfdef watchdog alert-tier finding\"}[1h]))",
          "legendFormat": "alert findings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "detection-watchdog warn findings (1h)",
      "description": "Count of warn-tier host detection-watchdog findings in the last hour, routed by the selfdef_watchdog_warn Sigma rule (SDD-062 D-5). Warn = config changed but the target is still trusted (a benign edit, a package-install artifact, a physical-TTY addition, a hardening_index in the moderate band, …). This is an Informational, NON-PAGING trend signal — it sits below the notifier panic floor and carries no Prometheus alert. Blue, never red. Investigate only if it correlates with an alert-tier finding.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 30 },
      "targets": [
        {
          "expr": "sum(increase(selfdef_findings_by_rule_total{rule=\"selfdef watchdog warn-tier finding\"}[1h]))",
          "legendFormat": "warn findings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Four-watchdog set (MS046 + MS047 + MS044 + MS048)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "friction-audit — failing gates",
      "description": "MS046 hardware-integrity gate — gates currently in Fail status (no operator override honoring). >0 = boot-time hardware integrity violated.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 31 },
      "targets": [
        {
          "expr": "selfdef_friction_audit_failing_total",
          "legendFormat": "failing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "perimeter — SIGKILLs in window",
      "description": "MS047 kernel-fence — sigkill verdicts currently in ring buffer. >0 = something non-allowlisted was killed in-kernel; investigate via selfdefctl perimeter history.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 31 },
      "targets": [
        {
          "expr": "selfdef_perimeter_sigkills_total",
          "legendFormat": "sigkills"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "guardian — failed responses",
      "description": "MS044 supervisor — guardian verdicts where any of the 3 response steps (SIGKILL / audit-append / console-alert) failed. >0 = supervisor response degraded.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 31 },
      "targets": [
        {
          "expr": "selfdef_guardian_failed_responses_total",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "scheduler — backpressured decisions",
      "description": "MS048 Goldilocks Scheduler — decisions made while any of the 5 backpressure surfaces was open (Blackwell VRAM / 3090 / CPU / RAM / IO / human-gate). High count = sustained resource pressure.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 31 },
      "targets": [
        {
          "expr": "selfdef_scheduler_backpressured_decisions_total",
          "legendFormat": "backpressured"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "Four-watchdog audit chain lengths",
      "description": "OCSF audit chain events for each watchdog. Plateau = no activity. Drop to -1 = chain integrity broken (see watchdog-audit-log-corruption runbook).",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
      "targets": [
        {
          "expr": "selfdef_perimeter_audit_chain_events",
          "legendFormat": "perimeter"
        },
        {
          "expr": "selfdef_guardian_audit_chain_events",
          "legendFormat": "guardian"
        },
        {
          "expr": "selfdef_scheduler_audit_chain_events",
          "legendFormat": "scheduler"
        }
      ]
    },
    {
      "id": 106,
      "type": "stat",
      "title": "perimeter — policy installed",
      "description": "1 = sovereign-perimeter.yaml present at /etc/tetragon/tracing-policies/. 0 = TracingPolicy missing; kernel-fence is OFF.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 45 },
      "targets": [
        {
          "expr": "selfdef_perimeter_policy_present",
          "legendFormat": "policy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 107,
      "type": "stat",
      "title": "guardian — tetragon socket present",
      "description": "1 = /var/run/tetragon/tetragon.events reachable. 0 = guardian can't ingest events.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 45 },
      "targets": [
        {
          "expr": "selfdef_guardian_tetragon_socket_present",
          "legendFormat": "socket"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 108,
      "type": "stat",
      "title": "perimeter — active extensions",
      "description": "Operator-signed allowlist extensions currently in effect. Each is MS003 multi-sig + TTL ≤ 30d.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 45 },
      "targets": [
        {
          "expr": "selfdef_perimeter_extensions_total",
          "legendFormat": "extensions"
        }
      ]
    },
    {
      "id": 109,
      "type": "stat",
      "title": "friction-audit — overrides honored",
      "description": "Boot-time gates currently honored by an operator-signed override manifest. Each is MS003-signed + TTL ≤ 7d.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 45 },
      "targets": [
        {
          "expr": "selfdef_friction_audit_overrides_total",
          "legendFormat": "overrides"
        }
      ]
    },
    {
      "id": 110,
      "type": "row",
      "title": "Module catalog (MS006 / SDD-009)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 }
    },
    {
      "id": 111,
      "type": "stat",
      "title": "modules — shipped",
      "description": "MS006 — count of modules at /usr/share/selfdef/modules/<name>/module.toml. Changes only on package upgrade.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 50 },
      "targets": [
        {
          "expr": "selfdef_modules_shipped_total",
          "legendFormat": "shipped"
        }
      ]
    },
    {
      "id": 112,
      "type": "stat",
      "title": "modules — active",
      "description": "MS006 — count of modules the operator activated in /etc/selfdef/modules.toml ([modules.<name>] sections). Operator-controlled; changes on 'selfdefctl modules apply'.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 50 },
      "targets": [
        {
          "expr": "selfdef_modules_active_total",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 120,
      "type": "row",
      "title": "M060 cross-repo mirror export (10 publishers)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 55 }
    },
    {
      "id": 121,
      "type": "stat",
      "title": "publishes — succeeded (5m rate sum)",
      "description": "M060 mirror-export — sum of per-artifact ok-publish rate over 5m across all 10 mirrors. Steady-state ≈ 10/30s = 0.333 publishes/s when the chain is fully online (all 10 ok every 30s tick).",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "sum(rate(selfdef_m060_mirror_publish_total{result=\"ok\"}[5m]))",
          "legendFormat": "ok/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.1  },
              { "color": "green",  "value": 0.25 }
            ]
          }
        }
      }
    },
    {
      "id": 122,
      "type": "stat",
      "title": "publishes — failed (5m increase sum)",
      "description": "M060 mirror-export — total failed publishes across all artifacts in the last 5 min. ANY non-zero value triggers the SelfdefM060PublishFailing alert.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 56 },
      "targets": [
        {
          "expr": "sum(increase(selfdef_m060_mirror_publish_total{result=\"failed\"}[5m]))",
          "legendFormat": "failed (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 5    }
            ]
          }
        }
      }
    },
    {
      "id": 123,
      "type": "stat",
      "title": "stalest publisher (age, seconds)",
      "description": "M060 mirror-export — for the artifact whose last successful publish is OLDEST, how long ago was it. Surfaces 'which publisher is stuck'. >300s triggers SelfdefM060PublishStale; >600s is critical.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 56 },
      "targets": [
        {
          "expr": "max(time() - selfdef_m060_mirror_last_publish_unix)",
          "legendFormat": "max(age)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 60   },
              { "color": "orange", "value": 300  },
              { "color": "red",    "value": 600  }
            ]
          }
        }
      }
    },
    {
      "id": 124,
      "type": "timeseries",
      "title": "publish rate per artifact (ok)",
      "description": "M060 mirror-export — 5m rate of successful publishes per artifact. Each artifact should hold steady at ≈ 0.033/s (1 publish per 30s tick). Drops to 0 = that artifact's publisher is wedged.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "targets": [
        {
          "expr": "rate(selfdef_m060_mirror_publish_total{result=\"ok\"}[5m])",
          "legendFormat": "{{artifact}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true }
      }
    },
    {
      "id": 125,
      "type": "timeseries",
      "title": "failed publishes per artifact (5m increase)",
      "description": "M060 mirror-export — 5m rolling increase of failed publishes per artifact. Identifies WHICH publisher is the source of an alert. A flat line at 0 = that publisher is healthy.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "targets": [
        {
          "expr": "increase(selfdef_m060_mirror_publish_total{result=\"failed\"}[5m])",
          "legendFormat": "{{artifact}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true }
      }
    },
    {
      "id": 126,
      "type": "table",
      "title": "per-artifact health snapshot",
      "description": "M060 mirror-export — current per-artifact state: ok count, failed count, age of last successful publish. Sort by `age` desc to find the stalest publisher; sort by `failed` desc to find the most-failing.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 68 },
      "targets": [
        {
          "expr": "selfdef_m060_mirror_publish_total{result=\"ok\"}",
          "legendFormat": "{{artifact}}",
          "format": "table",
          "instant": true,
          "refId": "OK"
        },
        {
          "expr": "selfdef_m060_mirror_publish_total{result=\"failed\"}",
          "legendFormat": "{{artifact}}",
          "format": "table",
          "instant": true,
          "refId": "FAIL"
        },
        {
          "expr": "time() - selfdef_m060_mirror_last_publish_unix",
          "legendFormat": "{{artifact}}",
          "format": "table",
          "instant": true,
          "refId": "AGE"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 130,
      "type": "row",
      "title": "Daemon health & retention liveness (SD-API /metrics)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 78 }
    },
    {
      "id": 131,
      "type": "stat",
      "title": "daemon uptime — restart detector",
      "description": "selfdef-daemon uptime in seconds. A sudden drop to ~0 means the daemon restarted; pair with an Alertmanager rule if unexpected restarts matter operationally.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 79 },
      "targets": [
        { "expr": "selfdef_uptime_seconds", "legendFormat": "uptime" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 132,
      "type": "stat",
      "title": "metrics ingest lag — events dropped",
      "description": "selfdef_ingest_lag_events_total — events the metrics ingest subscriber missed because the bus was over-subscribed. Non-zero means /metrics counters under-count reality; green at 0, red as soon as any event is dropped.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 79 },
      "targets": [
        { "expr": "selfdef_ingest_lag_events_total", "legendFormat": "dropped" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 133,
      "type": "stat",
      "title": "retention enabled (1 = sweeping)",
      "description": "selfdef_store_retention_enabled — 1 when the SDD-081 hot-store retention sweep loop is active, 0 when disabled. If 0 unexpectedly, the hot store grows unbounded.",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 79 },
      "targets": [
        { "expr": "selfdef_store_retention_enabled", "legendFormat": "enabled" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 134,
      "type": "timeseries",
      "title": "retention sweeps / hour — liveness (SDD-081)",
      "description": "rate(selfdef_store_retention_sweeps_total[1h]) — sweep cadence. A flat-zero line while retention_enabled=1 means the sweep loop wedged (the pruned-events panel can read 0 legitimately when nothing is old enough, so sweeps is the true liveness signal).",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 79 },
      "targets": [
        { "expr": "rate(selfdef_store_retention_sweeps_total[1h])", "legendFormat": "sweeps/s" }
      ]
    }
  ]
}
