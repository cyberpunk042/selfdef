# selfdef hidden-process-watchdog — service unit.

[Unit]
Description=selfdef hidden-process (rootkit) scan
Documentation=https://github.com/cyberpunk042/selfdef modules/hidden-process-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/hidden-process-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log
# The PID brute-force probe is CPU-light but tight-loop; nice
# it so it never disturbs operator-interactive work.
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=10m
