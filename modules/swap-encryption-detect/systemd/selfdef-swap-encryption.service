# selfdef swap-encryption-detect — service unit.

[Unit]
Description=selfdef swap encryption verification scan
Documentation=https://github.com/cyberpunk042/selfdef modules/swap-encryption-detect/README.md
After=local-fs.target swap.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/swap-encryption-detect.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log
Nice=10
TimeoutStartSec=2m
