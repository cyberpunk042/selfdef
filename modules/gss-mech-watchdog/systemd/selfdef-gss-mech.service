[Unit]
Description=selfdef GSSAPI mechanism-config delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/gss-mech-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/gss-mech-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
