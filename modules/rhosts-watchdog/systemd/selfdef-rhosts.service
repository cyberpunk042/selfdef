[Unit]
Description=selfdef rsh/rlogin trust-file (hosts.equiv/.rhosts) delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/rhosts-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/rhosts-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
