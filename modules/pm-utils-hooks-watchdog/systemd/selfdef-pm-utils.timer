# selfdef pm-utils-hooks-watchdog — boot+60min + daily 11:05.
# Extends the staggered ladder after tmpfiles (11:00). A dropped
# pm-utils hook self-triggers on the next suspend/resume or
# AC<->battery transition (lid, AC plug, idle suspend), so the daily
# catch bounds dwell time; the boot catch confirms the hook set
# after a restart.

[Unit]
Description=selfdef pm-utils power-event hook delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/pm-utils-hooks-watchdog/README.md

[Timer]
OnBootSec=60min
OnCalendar=*-*-* 11:05:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-pm-utils.service

[Install]
WantedBy=timers.target
