[Unit]
Description=selfdef SSH login rc (sshrc) delta scan
Documentation=https://github.com/cyberpunk042/selfdef modules/sshrc-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/sshrc-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log /var/lib/selfdef
Nice=15
TimeoutStartSec=1m
