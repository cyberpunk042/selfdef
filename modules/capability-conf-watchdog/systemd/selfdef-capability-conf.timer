# selfdef capability-conf-watchdog — boot+31min + daily 08:40.
# Extends the staggered ladder after xdg-autostart (08:35). Boot
# catch confirms the pam_cap grants after a restart (a grant takes
# effect on the next login).

[Unit]
Description=selfdef pam_cap capability.conf delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/capability-conf-watchdog/README.md

[Timer]
OnBootSec=31min
OnCalendar=*-*-* 08:40:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-capability-conf.service

[Install]
WantedBy=timers.target
