# selfdef musl-ld-path-watchdog — boot+76min + daily 12:35.
# Extends the staggered ladder after nm-vpn-plugin (12:30). A
# prepended writable dir in the musl path takes effect for the next
# dynamically-linked process launch (i.e. immediately, for nearly
# everything), so the daily catch bounds dwell time; the boot catch
# confirms the path file after a restart.

[Unit]
Description=selfdef musl dynamic-linker path delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/musl-ld-path-watchdog/README.md

[Timer]
OnBootSec=76min
OnCalendar=*-*-* 12:35:00
RandomizedDelaySec=10m
Persistent=true
Unit=selfdef-musl-ld-path.service

[Install]
WantedBy=timers.target
