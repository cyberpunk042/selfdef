#!/usr/sbin/nft -f
# selfdef bridge-l2 ruleset — managed by `selfdefctl modules apply`.
# Do not hand-edit; changes are clobbered on the next apply.
#
# Substituted at render time (must match apply.sh's sed expression):
#   @@BRIDGE_NAME@@        — Linux bridge interface (e.g. br0)
#   @@FORWARD_POLICY@@     — accept | drop
#   @@MGMT_INPUT_RULE@@    — input-chain drop rule for the management
#                            interface, or a no-op comment when unset

flush ruleset

table inet selfdef_bridge {
    # Other inline modules add jumps into this chain. The owning
    # module does not know about its consumers.
    chain forward_hook { }

    chain forward {
        type filter hook forward priority filter; policy @@FORWARD_POLICY@@;
        iifname "@@BRIDGE_NAME@@" jump forward_hook
        oifname "@@BRIDGE_NAME@@" jump forward_hook
    }

    chain input {
        type filter hook input priority filter; policy accept;
        # Management interface is outbound-only: drop everything inbound
        # except established/related so the operator's ssh session
        # survives.
        @@MGMT_INPUT_RULE@@
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
