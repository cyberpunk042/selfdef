# selfdef ssh-authkeys-watchdog — boot+7min + every 2h.
# Authorized-key injection is high-impact persistence; a 2h
# cadence catches it fast. Boot catch confirms the key set
# after every restart (a key added offline appears at boot).

[Unit]
Description=selfdef SSH authorized_keys delta scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/ssh-authkeys-watchdog/README.md

[Timer]
OnBootSec=7min
OnUnitActiveSec=2h
RandomizedDelaySec=5min
Persistent=true
Unit=selfdef-ssh-authkeys.service

[Install]
WantedBy=timers.target
