#!/usr/bin/env bash
# /etc/update-motd.d/50-selfdef-presence — verbose-profile dynamic motd.
#
# Pam-motd composes /etc/motd from numbered scripts in
# /etc/update-motd.d/. Our 50-prefix runs in the middle of the
# typical OS-shipped sequence (00-header, 10-help-text,
# 50-selfdef-presence, 90-updates-available).

echo "================================================================================"
echo "selfdef IPS status @ $(date -u +%FT%TZ)"
echo "--------------------------------------------------------------------------------"

# Active module count via the catalog.
MODULES_DIR="${SELFDEF_MODULES_DIR:-/etc/selfdef/modules}"
if [[ -d "$MODULES_DIR" ]]; then
    active=$(ls -1 "$MODULES_DIR"/*.toml 2>/dev/null | wc -l)
    echo "  active modules     : $active"
fi

# Recent alerts (last 24h).
if command -v journalctl >/dev/null 2>&1; then
    recent_alerts=$(journalctl -t selfdef-aide -t selfdef-rkhunter -t selfdef-clamav -t selfdef-lynis -t selfdef-time-skew --since '24 hours ago' --no-pager 2>/dev/null \
        | grep -cE '"severity":"(alert|high)"' || echo 0)
    echo "  alerts (24h)       : $recent_alerts"
fi

# fail2ban-bridge currently-banned IP count (best-effort).
if command -v fail2ban-client >/dev/null 2>&1; then
    banned=$(fail2ban-client banned 2>/dev/null | tr ',' '\n' | grep -cE '[0-9]+' 2>/dev/null || echo 0)
    [[ -n "$banned" ]] && echo "  fail2ban banned IPs: $banned"
fi

# Last successful login.
if command -v lastlog >/dev/null 2>&1; then
    last=$(lastlog -u "$USER" 2>/dev/null | tail -1)
    [[ -n "$last" ]] && echo "  your last login    : ${last:50}"
fi

echo "================================================================================"
