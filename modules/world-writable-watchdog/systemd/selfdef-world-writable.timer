# selfdef world-writable-watchdog — daily 05:00.
#
# Slot rationale: 02:30=aide, 03:30=clamav, 04:30=rkhunter,
# 05:00=world-writable, Sun-05:30=lynis (weekly),
# Sun-06:00=unowned-files (weekly). Daily 05:00 fits the
# permission-drift detection cadence near the end of the
# early-morning I/O budget.

[Unit]
Description=selfdef daily world-writable file scan timer
Documentation=https://github.com/cyberpunk042/selfdef modules/world-writable-watchdog/README.md

[Timer]
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=15m
Persistent=true
Unit=selfdef-world-writable.service

[Install]
WantedBy=timers.target
