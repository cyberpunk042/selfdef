# selfdef world-writable-watchdog — service unit.

[Unit]
Description=selfdef daily world-writable file scan
Documentation=https://github.com/cyberpunk042/selfdef modules/world-writable-watchdog/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/selfdef/world-writable-watchdog.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/dev/log
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=1h
