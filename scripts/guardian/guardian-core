# ---------- logging setup ----------

def setup_logging(verbose: bool, buffer_path: str) -> logging.Logger:
    """Configure logging with stdout (systemd journal capture per MS044 R10382) +
    buffered file (offline survivability per MS044 R10482).
    """
    fmt = "%(asctime)s.%(msecs)03dZ %(name)s %(levelname)s %(message)s"
    datefmt = "%Y-%m-%dT%H:%M:%S"

    handler_stdout = logging.StreamHandler(sys.stdout)
    handler_stdout.setFormatter(logging.Formatter(fmt, datefmt))

    log = logging.getLogger(GUARDIAN_BINARY_NAME)
    log.setLevel(logging.DEBUG if verbose else logging.INFO)
    log.addHandler(handler_stdout)

    # Try to add rotating buffer for offline survivability per MS044 R10482-R10485.
    # Fall back to stdout-only if the buffer dir is unwritable (e.g. during
    # bootstrap before MS037 filesystem grants land).
    try:
        Path(buffer_path).parent.mkdir(parents=True, exist_ok=True)
        handler_buffer = logging.handlers.RotatingFileHandler(
            buffer_path,
            maxBytes=64 * 1024 * 1024,  # 64 MB per file
            backupCount=10,             # ~640 MB total per MS044 R10485 365-day retention budget
        )
        handler_buffer.setFormatter(logging.Formatter(fmt, datefmt))
        log.addHandler(handler_buffer)
    except OSError as exc:
        log.warning("buffer log unavailable at %s: %s — continuing stdout-only", buffer_path, exc)

    return log


# ---------- atomic audit log write per MS044 R10386-R10395 ----------

def append_atomic_audit_log(audit_log_path: str, line: str) -> bool:
    """Atomic append to security audit log on ZFS sync=always dataset.

    Per dump 531-533 + MS044 R10388 + R10390 + sovereign-os M068 R11432:
    - file opened with mode "a" (append)
    - newline appended explicitly
    - flush + fsync to force ZFS sync=always commit
    - file mode 0640 per MS044 R10391

    Returns True on successful write, False otherwise.
    """
    try:
        # ensure parent directory exists (may be on a not-yet-mounted ZFS dataset)
        parent = Path(audit_log_path).parent
        try:
            parent.mkdir(parents=True, exist_ok=True)
        except OSError:
            pass  # parent may be read-only; we'll fail on open below

        # Use os.open + os.write to control mode precisely
        flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
        # O_DSYNC for atomic commit; falls back gracefully if not supported
        if hasattr(os, "O_DSYNC"):
            flags |= os.O_DSYNC
        fd = os.open(audit_log_path, flags, 0o640)
        try:
            # POSIX guarantees a single write < PIPE_BUF (typically 4096) is
            # atomic w.r.t. interleaving concurrent writers. Combine line +
            # newline into ONE buffer + ONE write call so per-line atomicity
            # is preserved under multi-threaded / multi-process appenders.
            buf = line.encode("utf-8")
            if not buf.endswith(b"\n"):
                buf += b"\n"
            os.write(fd, buf)
            try:
                os.fsync(fd)
            except OSError:
                pass  # fsync may not be supported on all FS; ZFS sync=always covers durability
        finally:
            os.close(fd)
        return True
    except OSError as exc:
        if _log:
            _log.error("audit log append failed (%s): %s", audit_log_path, exc)
        return False


# ---------- console bell per dump 535-536 + MS044 R10396-R10400 ----------

def console_bell_disabled() -> bool:
    """Per MS044 R10399, operator can disable console bell via
    /etc/selfdef/guardian/console-bell.toml. Returns True if disabled.
    """
    try:
        if not Path(BELL_TOGGLE_CONFIG).exists():
            return False
        # parse minimal TOML — looking for `enabled = false`
        content = Path(BELL_TOGGLE_CONFIG).read_text(encoding="utf-8")
        for line in content.splitlines():
            line = line.strip()
            if line.startswith("enabled"):
                if "false" in line.lower():
                    return True
        return False
    except OSError:
        return False


def emit_console_bell(device: str) -> None:
    """Hardware-level audio alert via PC speaker bell per dump 536 +
    MS044 R10396. Operator-toggleable per R10399 — disable does NOT skip
    response 1 (SIGKILL) or response 2 (audit log) per R10400.
    """
    if console_bell_disabled():
        return
    try:
        # echo -e '\a' > /dev/console (BEL character)
        with open(device, "wb") as f:
            f.write(b"\a")
    except OSError as exc:
        # Failing to ring the bell is non-fatal; log + continue per MS044 boundary discipline
        if _log:
            _log.debug("console bell emit failed (%s): %s", device, exc)


# ---------- response: SIGKILL container per dump 527-529 + MS044 R10376-R10385 ----------

def alert_and_neutralize(
    container_id: str,
    process_name: str,
    violated_syscall: str,
    audit_log_path: str,
    console_device: str,
) -> dict[str, Any]:
    """3-step response protocol per MS044 R10376-R10398 verbatim.

    Step 1: SIGKILL via `podman kill <container_id>` (instant hardware-level
            neutralization per dump 981 + R10379).
    Step 2: Atomic append to ZFS audit log (sync=always per M068 R11432).
    Step 3: Console bell via /dev/console (hardware-level, no display server
            dependency per R10398).

    Returns dict with response outcome for tracing (MS044 R10384 M049 trace).
    """
    ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
    outcome: dict[str, Any] = {
        "ts": ts,
        "action": "SIGKILL",
        "container_id": container_id,
        "process_name": process_name,
        "violated_syscall": violated_syscall,
        "response_taken": {"sigkill": False, "audit_log": False, "console_bell": False},
    }

    # Step 1 — log to stdout (systemd journal captures per MS044 R10382)
    crit_line = f"{LOG_PREFIX_VIOLATION}: Container {container_id} executed {violated_syscall} via {process_name}"
    if _log:
        _log.critical(crit_line)
    else:
        # bootstrap path — write directly
        print(crit_line, file=sys.stderr, flush=True)

    # Step 1 — SIGKILL via podman per dump 529 + MS044 R10376-R10378
    try:
        result = subprocess.run(
            ["podman", "kill", container_id],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5.0,
        )
        outcome["response_taken"]["sigkill"] = (result.returncode == 0)
        outcome["sigkill_returncode"] = result.returncode
    except (subprocess.SubprocessError, OSError) as exc:
        if _log:
            _log.error("podman kill failed for %s: %s", container_id, exc)
        outcome["sigkill_error"] = str(exc)

    # Step 2 — Atomic audit log append per dump 532 + MS044 R10389
    audit_line = (
        f"{ts} {LOG_PREFIX_NEUTRALIZED} {process_name} ({container_id}) "
        f"attempting {violated_syscall}"
    )
    outcome["response_taken"]["audit_log"] = append_atomic_audit_log(audit_log_path, audit_line)

    # Step 3 — Console bell per dump 536 + MS044 R10396 (operator-toggleable)
    emit_console_bell(console_device)
    outcome["response_taken"]["console_bell"] = not console_bell_disabled()

    # M049 trace stub — emit as structured stdout for journald/M049 collector
    if _log:
        _log.info("guardian_response %s", json.dumps(outcome))

    return outcome


# ---------- event parser per dump 545-554 + MS044 R10361-R10367 ----------

def parse_event(line: str) -> tuple[bool, dict[str, str]]:
    """Parse one JSON event line from Tetragon socket.

    Returns (should_respond, extracted_fields). On JSON decode failure,
    returns (False, {}) — caller skips the line per MS044 R10358.
    """
    try:
        event = json.loads(line)
    except (json.JSONDecodeError, ValueError):
        # Per dump 561-562 + MS044 R10358 — skip corrupt JSON lines
        return False, {}

    action = (event.get("action") or "").strip()
    action_lower = action.lower()
    should_respond = (
        action == "SIGKILL"
        or "process" in action_lower
    )
    if not should_respond:
        return False, {}

    process = event.get("process") or {}
    syscall = event.get("syscall") or {}
    extracted = {
        "container_id": str(process.get("docker") or ""),
        "process_name": str(process.get("binary") or ""),
        "violated_syscall": str(syscall.get("name") or "sys_execve"),  # default per MS044 R10367
    }
    return True, extracted


# ---------- main event loop per dump 538-562 + MS044 R10350-R10408 ----------

def write_probe(path: str, content: str = "ok\n") -> None:
    """Write systemd readiness/liveness probe."""
    try:
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text(content, encoding="utf-8")
    except OSError as exc:
        if _log:
            _log.warning("probe write failed at %s: %s", path, exc)


def handle_shutdown(signum: int, _frame: Any) -> None:
    """Per MS044 R10406-R10407 — clean shutdown on SIGTERM/SIGINT."""
    if _log:
        _log.info("shutdown requested via signal %d", signum)
    _shutdown_requested.set()


def main_loop(socket_path: str, audit_log_path: str, console_device: str) -> int:
    """Main Tetragon event loop per dump 538-562 + MS044 R10350-R10408.

    Returns EXIT_OK on graceful (signal-driven) shutdown per MS044 R10545,
    or the internal _SOURCE_LOST sentinel when the event pipe is absent or
    the stream drops (writer EOF / OSError) — the supervised caller
    (`run_supervised`) waits and re-opens instead of letting the process
    die into the systemd start-limit (Tetragon-socket-dropout gotcha,
    operator audit 2026-06-10).
    """
    global _log
    log = _log
    assert log is not None

    # Verify Tetragon socket exists per dump 540-543 + MS044 R10353-R10355
    if not Path(socket_path).exists():
        msg = f"Error: Tetragon event pipe not initialized at {socket_path}"
        log.error(msg)
        print(msg, file=sys.stderr, flush=True)
        return _SOURCE_LOST

    # Startup banner verbatim per dump 538 + MS044 R10401
    log.info(LOG_PREFIX_STARTUP)
    write_probe(READINESS_PROBE)
    write_probe(LIVENESS_PROBE)

    events_seen = 0
    responses_emitted = 0
    last_liveness_touch = time.monotonic()

    try:
        # Open Tetragon event socket per dump 540-541 + MS044 R10352
        with open(socket_path, "r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                if _shutdown_requested.is_set():
                    break
                events_seen += 1

                # Periodically refresh liveness probe (every ~5s of activity)
                now = time.monotonic()
                if now - last_liveness_touch > 5.0:
                    write_probe(LIVENESS_PROBE, f"ok {now:.0f}\n")
                    last_liveness_touch = now

                should_respond, fields = parse_event(line)
                if not should_respond:
                    continue

                # alert_and_neutralize performs the 3-step response AND emits
                # the M049 trace internally (the returned outcome dict is for
                # optional caller use; we don't need it here).
                alert_and_neutralize(
                    container_id=fields["container_id"],
                    process_name=fields["process_name"],
                    violated_syscall=fields["violated_syscall"],
                    audit_log_path=audit_log_path,
                    console_device=console_device,
                )
                responses_emitted += 1

    except OSError as exc:
        # Socket dropped mid-stream — report source-lost so the supervised
        # loop re-opens in-process (systemd restart is only the backstop).
        log.error("socket read failed (events_seen=%d, responses=%d): %s",
                  events_seen, responses_emitted, exc)
        return _SOURCE_LOST
    except KeyboardInterrupt:
        log.info("shutdown via KeyboardInterrupt (events_seen=%d, responses=%d)",
                 events_seen, responses_emitted)
        return EXIT_OK

    if _shutdown_requested.is_set():
        log.info("clean shutdown (events_seen=%d, responses=%d)",
                 events_seen, responses_emitted)
        return EXIT_OK

    # EOF WITHOUT a shutdown request: the writer (Tetragon) closed the pipe —
    # e.g. a Tetragon restart during a firewall/VLAN reconfiguration. This is
    # a lost source, NOT a clean shutdown; the previous exit-0-here let a
    # routine Tetragon restart silently terminate the guardian's pass and
    # depend entirely on the systemd restart cycle (start-limit fail-open).
    log.warning("event stream EOF without shutdown (events_seen=%d, responses=%d) — source lost",
                events_seen, responses_emitted)
    return _SOURCE_LOST


def run_supervised(
    socket_path: str,
    audit_log_path: str,
    console_device: str,
    reconnect_delay_secs: float = RECONNECT_DELAY_SECS,
) -> int:
    """Supervised wrapper around `main_loop` — closes the Tetragon-socket-
    dropout gotcha (operator audit 2026-06-10).

    When the event pipe is absent, or the stream drops (writer EOF /
    OSError), wait `reconnect_delay_secs` and re-open instead of exiting.
    Without this, a socket gap longer than ~5s (firewall/VLAN reconfig,
    Tetragon upgrade) drove the unit into systemd's default start-limit and
    permanently killed the Ring 0 containment. Exits EXIT_OK only on a
    signal-driven shutdown.
    """
    log = _log
    assert log is not None
    waited_cycles = 0
    while not _shutdown_requested.is_set():
        if not Path(socket_path).exists():
            # Rate-limited waiting line — first miss, then every
            # _WAIT_LOG_EVERY_CYCLES retries (≈ once a minute at defaults).
            if waited_cycles % _WAIT_LOG_EVERY_CYCLES == 0:
                log.warning(
                    "Tetragon event pipe absent at %s — waiting (%.1fs cadence, cycle %d)",
                    socket_path, reconnect_delay_secs, waited_cycles,
                )
            waited_cycles += 1
        else:
            rc = main_loop(socket_path, audit_log_path, console_device)
            if rc != _SOURCE_LOST:
                return rc
            waited_cycles = 0  # fresh outage → log the first wait line again
        # Sleep in small slices so SIGTERM during the wait exits promptly.
        deadline = time.monotonic() + reconnect_delay_secs
        while time.monotonic() < deadline:
            if _shutdown_requested.is_set():
                return EXIT_OK
            time.sleep(min(0.1, reconnect_delay_secs))
    return EXIT_OK


# ---------- CLI ----------

def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=GUARDIAN_BINARY_NAME,
        description=(
            "selfdef MS044 Guardian Daemon — Tetragon eBPF event supervisor "
            "with instant SIGKILL + atomic ZFS audit log + console bell. "
            "Replaces SecureToast.ps1; native Linux; no visual or network bloat."
        ),
    )
    parser.add_argument("--socket", default=DEFAULT_SOCKET_PATH,
                        help=f"Tetragon event socket path (default: {DEFAULT_SOCKET_PATH})")
    parser.add_argument("--audit-log", default=DEFAULT_AUDIT_LOG_PATH,
                        help=f"Atomic ZFS audit log path (default: {DEFAULT_AUDIT_LOG_PATH})")
    parser.add_argument("--buffer-log", default=DEFAULT_BUFFER_LOG_PATH,
                        help=f"Offline-buffer log path (default: {DEFAULT_BUFFER_LOG_PATH})")
    parser.add_argument("--console", default=DEFAULT_CONSOLE_DEVICE,
                        help=f"Console device for bell (default: {DEFAULT_CONSOLE_DEVICE})")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="enable DEBUG logging")
    parser.add_argument("--version", action="version",
                        version=f"{GUARDIAN_BINARY_NAME} {GUARDIAN_VERSION} "
                                f"(selfdef MS044 — operator-cited 2026-05-15 dump 513-588)")
    parser.add_argument("--dry-run", action="store_true",
                        help="parse args + verify socket + exit; do not enter event loop")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    global _log

    args = parse_args(argv)

    # Doctrinal-preservation self-check
    try:
        _verify_doctrinal_preservation()
    except AssertionError as exc:
        print(f"FATAL: {exc}", file=sys.stderr, flush=True)
        return 1

    _log = setup_logging(verbose=args.verbose, buffer_path=args.buffer_log)

    # Signal handlers per MS044 R10406-R10407
    signal.signal(signal.SIGTERM, handle_shutdown)
    signal.signal(signal.SIGINT, handle_shutdown)

    _log.info("%s %s starting (socket=%s audit_log=%s)",
              GUARDIAN_BINARY_NAME, GUARDIAN_VERSION, args.socket, args.audit_log)

    if args.dry_run:
        ok = Path(args.socket).exists()
        _log.info("dry-run: socket exists=%s — exiting", ok)
        return EXIT_OK if ok else EXIT_INIT_FAILURE

    return run_supervised(args.socket, args.audit_log, args.console)


if __name__ == "__main__":
    sys.exit(main())
