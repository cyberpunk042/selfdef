def find_repo_root(start: Path) -> Path:
    """Walk up from start until we find the selfdef workspace root (Cargo.toml + crates/)."""
    p = start.resolve()
    while p != p.parent:
        if (p / "Cargo.toml").is_file() and (p / "crates").is_dir():
            return p
        p = p.parent
    raise SystemExit(f"selfdef workspace root not found from {start}")


def main(argv: Optional[list[str]] = None) -> int:
    ap = argparse.ArgumentParser(description="selfdef-ux-harness — MS045 UX coherence test harness")
    ap.add_argument("--json", action="store_true", help="emit JSON report to stdout")
    ap.add_argument("--verbose", "-v", action="store_true", help="emit per-check status to stderr")
    ap.add_argument("--layer", choices=["L1", "L2", "L3", "L4", "L5"], help="run only checks for one layer")
    ap.add_argument("--name", help="run only the check with this exact name")
    ap.add_argument("--repo-root", help="override workspace root detection")
    ap.add_argument("--cli-samples", type=int, default=CLI_STARTUP_SAMPLES, help="CLI startup bench sample count")
    args = ap.parse_args(argv)

    repo_root = Path(args.repo_root).resolve() if args.repo_root else find_repo_root(Path.cwd())
    h = Harness(repo_root, verbose=args.verbose)

    for name, layer, fn in CHECKS:
        if args.layer and layer != args.layer:
            continue
        if args.name and name != args.name:
            continue
        if name == "cli-startup-p95":
            h.run(name, layer, lambda: check_cli_startup_p95(repo_root, samples=args.cli_samples))
        else:
            h.run(name, layer, lambda fn=fn: fn(repo_root))

    counts = h.summary_counts()
    if args.json:
        report = {
            "schema": "selfdef-ux-harness/1.0.0",
            "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "repo_root": str(repo_root),
            "counts": counts,
            "results": [
                {
                    "name": r.name, "layer": r.layer, "passed": r.passed,
                    "summary": r.summary, "duration_ms": r.duration_ms, "detail": r.detail,
                }
                for r in h.results
            ],
        }
        json.dump(report, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:
        for r in h.results:
            status = "PASS" if r.passed else "FAIL"
            print(f"[{r.layer}] {status:4s}  {r.name:<35s}  {r.summary}")
        print()
        print(f"Total: {counts['total']}  Passed: {counts['passed']}  Failed: {counts['failed']}")

    # exit-zero only if every check passed (deferred checks pass by design)
    return 0 if h.passed else 1


if __name__ == "__main__":
    sys.exit(main())
