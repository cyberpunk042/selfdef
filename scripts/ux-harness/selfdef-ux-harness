def check_mirror_crate_list(repo_root: Path) -> tuple[bool, str, dict]:
    """R10569 — mirror crate list (9 crates) matches MS043 schema."""
    crates_dir = repo_root / "crates"
    found = sorted(
        p.name for p in crates_dir.iterdir()
        if p.is_dir() and p.name.endswith("-mirror") and p.name.startswith("selfdef-")
    )
    expected = sorted(EXPECTED_MIRROR_CRATES)
    if found == expected:
        return True, f"all 9 mirror crates present", {"crates": found}
    missing = [c for c in expected if c not in found]
    extra = [c for c in found if c not in expected]
    return False, f"mirror crate drift: missing={missing} extra={extra}", {
        "expected": expected, "found": found, "missing": missing, "extra": extra,
    }


def check_cli_subcommand_schema(repo_root: Path) -> tuple[bool, str, dict]:
    """R10566 — CLI subcommand list discoverable + non-empty.
    Without a built `selfdefctl --list-subcommands`, this lints presence of CLI crate.
    """
    cli_crate = repo_root / "crates" / "selfdef-cli"
    cli_mirror = repo_root / "crates" / "selfdef-cli-mirror" / "src" / "lib.rs"
    if not cli_crate.is_dir():
        return False, "selfdef-cli crate missing", {"path": str(cli_crate)}
    if not cli_mirror.is_file():
        return False, "selfdef-cli-mirror lib.rs missing", {"path": str(cli_mirror)}
    text = cli_mirror.read_text()
    if "DOCTRINE_FULLSTACK_AT_THE_EDGES" not in text:
        return False, "selfdef-cli-mirror doctrine constant missing", {}
    if DOCTRINE_FULLSTACK_AT_THE_EDGES not in text:
        return False, f"selfdef-cli-mirror doctrine string not verbatim", {"expected": DOCTRINE_FULLSTACK_AT_THE_EDGES}
    return True, "CLI surface schema present + doctrine verbatim", {}


