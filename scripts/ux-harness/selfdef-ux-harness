# ----------------------------- check infrastructure ------------------------- #

@dataclass
class CheckResult:
    """Single check result. Wire-stable for --json output."""
    name: str
    layer: str   # "L1" / "L2" / "L3" / "L4" / "L5"
    passed: bool
    summary: str
    detail: dict = field(default_factory=dict)
    duration_ms: float = 0.0


class Harness:
    """Aggregates check results + emits structured report."""

    def __init__(self, repo_root: Path, verbose: bool):
        self.repo_root = repo_root
        self.verbose = verbose
        self.results: list[CheckResult] = []

    def run(self, name: str, layer: str, fn: Callable[[], tuple[bool, str, dict]]) -> CheckResult:
        t0 = time.monotonic()
        try:
            passed, summary, detail = fn()
        except Exception as e:  # check authors should not raise; defend anyway
            passed, summary, detail = False, f"check raised exception: {e}", {"exception": str(e)}
        dt = (time.monotonic() - t0) * 1000
        r = CheckResult(name=name, layer=layer, passed=passed, summary=summary, detail=detail, duration_ms=dt)
        self.results.append(r)
        if self.verbose:
            status = "PASS" if passed else "FAIL"
            print(f"[{layer}] {status:4s}  {name:<60s}  {summary}", file=sys.stderr)
        return r

    @property
    def passed(self) -> bool:
        return all(r.passed for r in self.results)

    def summary_counts(self) -> dict[str, int]:
        c = {"total": len(self.results), "passed": 0, "failed": 0}
        for r in self.results:
            if r.passed:
                c["passed"] += 1
            else:
                c["failed"] += 1
        return c


